{% doc %}
  @prompt
    Create a utility section named “Safe Spacer / Divider” to separate sections and prevent visual overlap.
    
    Behavior & safety:
    
    Wrapper must create its own stacking/isolation context: position: relative; isolation: isolate; z-index: 0; clear: both; contain: layout paint;.
    
    No negative margins anywhere.
    
    Optional thin divider (1px hairline) centered across the width.
    
    Controls (schema):
    
    padding_top and padding_bottom sliders (0–160px), defaults: 64px desktop / 32px mobile.
    
    show_divider (boolean).
    
    divider_style (solid | dotted | none), color picker (default #EDEAE4), width 100%.
    
    background_color picker (default: page background).
    
    Layout: full-width container matching theme width; responsive paddings.
    No external dependencies.
    Scope all styles inside this section only.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-safe-spacer-{{ ai_gen_id }} {
    position: relative;
    isolation: isolate;
    z-index: 0;
    clear: both;
    contain: layout paint;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
  }

  .ai-safe-spacer-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    position: relative;
  }

  .ai-safe-spacer-divider-{{ ai_gen_id }} {
    width: 100%;
    height: 1px;
    background-color: {{ block.settings.divider_color }};
    margin: 0 auto;
    {% if block.settings.divider_style == 'dotted' %}
      background-image: repeating-linear-gradient(
        to right,
        {{ block.settings.divider_color }} 0px,
        {{ block.settings.divider_color }} 4px,
        transparent 4px,
        transparent 8px
      );
      background-color: transparent;
    {% elsif block.settings.divider_style == 'none' %}
      display: none;
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    .ai-safe-spacer-{{ ai_gen_id }} {
      padding-top: {{ block.settings.padding_top | times: 0.5 }}px;
      padding-bottom: {{ block.settings.padding_bottom | times: 0.5 }}px;
    }

    .ai-safe-spacer-container-{{ ai_gen_id }} {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .ai-safe-spacer-{{ ai_gen_id }} {
      padding-top: {{ block.settings.padding_top | times: 0.75 }}px;
      padding-bottom: {{ block.settings.padding_bottom | times: 0.75 }}px;
    }
  }
{% endstyle %}

<div
  class="ai-safe-spacer-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-safe-spacer-container-{{ ai_gen_id }}">
    {% if block.settings.show_divider %}
      <div class="ai-safe-spacer-divider-{{ ai_gen_id }}"></div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Safe Spacer / Divider",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Top spacing",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 64
    },
    {
      "type": "header",
      "content": "Divider"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider",
      "default": false
    },
    {
      "type": "select",
      "id": "divider_style",
      "label": "Divider style",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#EDEAE4"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Safe Spacer / Divider"
    }
  ]
}
{% endschema %}