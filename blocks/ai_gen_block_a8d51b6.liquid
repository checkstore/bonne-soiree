      "label": "Banner height (mobile)",
      "default": 400
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Space between columns",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Space between banners (mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Section padding",
      "default": 40
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 60,
      "step": 5,
