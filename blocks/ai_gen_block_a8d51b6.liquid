{% doc %}
  @prompt
    Create a custom section with three banners displayed side by side on desktop (3 columns) and stacked vertically on mobile.
    
    Each banner must include:
    
    An image (fully replaceable)
    
    A title centered in the middle of the image
    
    A button below the title that links to a page of my choice (editable link)
    
    Design requirements:
    
    Typography: “Times New Roman”, serif for both title and button
    
    The layout must use a 3-column grid on desktop and 1-column stacking on mobile
    
    The title and button should be perfectly centered (both vertically and horizontally)
    
    Add a subtle dark overlay on images to ensure text readability (around 20–30%)
    
    Button should have a minimalist style — lowercase text, thin white border, and small hover effect (slight image zoom or brightness)
    
    Keep generous spacing (padding) around text so it feels balanced and editorial
    
    The entire section should be responsive and elegant, with clean alignment and consistent proportions
    
    Editor customization:
    
    Make all content editable (images, titles, button labels, and links)
    
    Allow adjusting image height and overlay opacity
    
    Ensure titles and buttons are legible on any image background
    
    The final look should feel minimal, chic, and editorial, similar to luxury fashion brand websites., Please adjust the section you created:
    
    1️⃣ Make the banners slightly smaller in height — keep the same proportions but reduce their overall vertical size for a more balanced look.
    
    2️⃣ Remove the hover animation (no zoom, no brightness change). The hover state should remain minimal and static, maintaining a clean and elegant aesthetic.
    
    Keep everything else as is — same font (“Times New Roman”), layout (3 side-by-side on desktop, stacked on mobile), centered title and button, and subtle overlay., Please refine the banner section with the following adjustments:
    
    1️⃣ Reduce the spacing between the title and the button — they should feel visually connected, almost like part of the same block (around half the current distance).
    
    2️⃣ Make the button slightly smaller — reduce its height and padding for a more delicate, minimal look. Keep the border thin and in the same style.
    
    Do not change the layout, font (“Times New Roman”), alignment, or proportions of the banners — just adjust the spacing and button size for a more refined, editorial balance.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-triple-banner-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-triple-banner__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.column_gap }}px;
    max-width: 100%;
    padding: 0 20px;
  }

  .ai-triple-banner__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    height: {{ block.settings.banner_height }}px;
  }

  .ai-triple-banner__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .ai-triple-banner__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-triple-banner__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-triple-banner__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
    opacity: 0.3;
  }

  .ai-triple-banner__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: 1;
  }

  .ai-triple-banner__content-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    text-align: center;
    width: 90%;
    padding: 40px 20px;
  }

  .ai-triple-banner__title-{{ ai_gen_id }} {
    font-family: "Times New Roman", serif;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 15px 0;
    font-weight: 400;
    letter-spacing: 0.5px;
    line-height: 1.3;
  }

  .ai-triple-banner__button-{{ ai_gen_id }} {
    display: inline-block;
    font-family: "Times New Roman", serif;
    font-size: {{ block.settings.button_size }}px;
    color: {{ block.settings.text_color }};
    text-decoration: none;
    text-transform: lowercase;
    padding: 8px 24px;
    border: 1px solid {{ block.settings.text_color }};
    background-color: transparent;
    transition: background-color 0.3s ease, color 0.3s ease;
    letter-spacing: 1px;
  }

  .ai-triple-banner__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.text_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-triple-banner__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 4px;
  }

  @media screen and (max-width: 749px) {
    .ai-triple-banner__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
      padding: 0 16px;
    }

    .ai-triple-banner__item-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_banner_height }}px;
    }

    .ai-triple-banner__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
      margin-bottom: 12px;
    }

    .ai-triple-banner__button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_size | times: 0.9 }}px;
      padding: 7px 20px;
    }

    .ai-triple-banner__content-{{ ai_gen_id }} {
      padding: 30px 15px;
    }
  }
{% endstyle %}

<div class="ai-triple-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-triple-banner__grid-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      {% liquid
        assign image_key = 'banner_' | append: i | append: '_image'
        assign title_key = 'banner_' | append: i | append: '_title'
        assign button_text_key = 'banner_' | append: i | append: '_button_text'
        assign button_link_key = 'banner_' | append: i | append: '_button_link'

        assign banner_image = block.settings[image_key]
        assign banner_title = block.settings[title_key]
        assign banner_button_text = block.settings[button_text_key]
        assign banner_button_link = block.settings[button_link_key]
      %}

      <div class="ai-triple-banner__item-{{ ai_gen_id }}">
        <div class="ai-triple-banner__image-wrapper-{{ ai_gen_id }}">
          {% if banner_image %}
            <img
              src="{{ banner_image | image_url: width: 1200 }}"
              alt="{{ banner_image.alt | escape }}"
              loading="lazy"
              width="{{ banner_image.width }}"
              height="{{ banner_image.height }}"
              class="ai-triple-banner__image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-triple-banner__placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-triple-banner__empty-state-{{ ai_gen_id }}">
                Add image {{ i }}
              </div>
            </div>
          {% endif %}

          <div class="ai-triple-banner__overlay-{{ ai_gen_id }}"></div>

          <div class="ai-triple-banner__content-{{ ai_gen_id }}">
            {% if banner_title != blank %}
              <h2 class="ai-triple-banner__title-{{ ai_gen_id }}">{{ banner_title }}</h2>
            {% endif %}

            {% if banner_button_text != blank %}
              <a
                href="{{ banner_button_link | default: '#' }}"
                class="ai-triple-banner__button-{{ ai_gen_id }}"
              >
                {{ banner_button_text }}
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Triple banner",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
