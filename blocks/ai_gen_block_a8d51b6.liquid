      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Button size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Banner 1"
    },
    {
      "type": "image_picker",
      "id": "banner_1_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "banner_1_title",
      "label": "Title",
      "default": "New Collection"
    },
    {
      "type": "text",
      "id": "banner_1_button_text",
      "label": "Button text",
      "default": "shop now"
    },
    {
      "type": "url",
      "id": "banner_1_button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Banner 2"
    },
    {
      "type": "image_picker",
      "id": "banner_2_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "banner_2_title",
      "label": "Title",
      "default": "Summer Essentials"
    },
    {
      "type": "text",
      "id": "banner_2_button_text",
      "label": "Button text",
      "default": "discover"
    },
    {
      "type": "url",
      "id": "banner_2_button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Banner 3"
    },
    {
      "type": "image_picker",
      "id": "banner_3_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "banner_3_title",
      "label": "Title",
      "default": "Limited Edition"
    },
    {
      "type": "text",
      "id": "banner_3_button_text",
      "label": "Button text",
      "default": "explore"
    },
    {
      "type": "url",
      "id": "banner_3_button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Triple banner"
    }
  ]
