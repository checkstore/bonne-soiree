{% doc %}
  @prompt
    Create a new Shopify Online Store 2.0 section called "Featured Collection (2×2 Grid)" in the Bonne Soirée style — minimal, editorial, timeless and clean.
    
    Display 4 products from a selected collection (default), with a product count selector (2–8 products).
    
    Layout:
    
    Desktop:
    - 2 columns × 2 rows.
    - Center the grid.
    - Max width: 780px.
    - Gap: 16–20px between columns, 24px between rows.
    - Side padding: 40px.
    
    Mobile:
    - 2 columns × 2 rows.
    - Gap: 8–12px between columns, 16px between rows.
    - Side padding: 12–16px.
    
    Product card:
    - Show image, title and price.
    - No rounded corners.
    - No borders or shadows.
    - Title and price left-aligned using Times New Roman (or the theme serif font).
    
    Product image:
    - Keep a fixed 4:5 image container.
    - Display the entire product image without cropping.
    - Use object-fit: contain.
    - Center the image.
    - Preserve the original proportions.
    - Do not zoom or stretch the image.
    - Leave a subtle white margin around the image so the complete product photo fits inside the card.
    
    Include settings for:
    - Collection picker
    - Product count
    - Section heading
    - Show/hide heading
    
    Fully responsive and compatible with Shopify Online Store 2.0.
    
    Use a fixed image container with a 4:5 ratio, but fit the complete product image inside the container.
    
    object-fit: contain;
    object-position: center;
    
    The product image should occupy approximately 90% to 94% of the available image container.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-collection-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px;
  }

  .ai-featured-collection-container-{{ ai_gen_id }} {
    max-width: 780px;
    margin: 0 auto;
  }

  .ai-featured-collection-heading-{{ ai_gen_id }} {
    font-family: 'Times New Roman', serif;
    font-size: 24px;
    font-weight: 400;
    text-align: center;
    margin: 0 0 32px;
    color: #000000;
  }

  .ai-featured-collection-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px 18px;
  }

  .ai-featured-collection-card-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .ai-featured-collection-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 125%;
    background-color: #ffffff;
    margin-bottom: 12px;
    overflow: hidden;
  }

  .ai-featured-collection-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    padding: 3%;
  }

  .ai-featured-collection-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f9f9f9;
  }

  .ai-featured-collection-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-featured-collection-info-{{ ai_gen_id }} {
    text-align: left;
  }

  .ai-featured-collection-title-{{ ai_gen_id }} {
    font-family: 'Times New Roman', serif;
    font-size: 14px;
    font-weight: 400;
    margin: 0 0 4px;
    color: #000000;
    line-height: 1.4;
  }

  .ai-featured-collection-price-{{ ai_gen_id }} {
    font-family: 'Times New Roman', serif;
    font-size: 14px;
    font-weight: 400;
    color: #000000;
  }

  @media screen and (max-width: 749px) {
    .ai-featured-collection-{{ ai_gen_id }} {
      padding: 12px;
    }

    .ai-featured-collection-heading-{{ ai_gen_id }} {
      font-size: 20px;
      margin-bottom: 24px;
    }

    .ai-featured-collection-grid-{{ ai_gen_id }} {
      gap: 16px 10px;
    }

    .ai-featured-collection-image-wrapper-{{ ai_gen_id }} {
      margin-bottom: 8px;
    }

    .ai-featured-collection-title-{{ ai_gen_id }} {
      font-size: 12px;
    }

    .ai-featured-collection-price-{{ ai_gen_id }} {
      font-size: 12px;
    }
  }
{% endstyle %}

<featured-collection-{{ ai_gen_id }}
  class="ai-featured-collection-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-featured-collection-container-{{ ai_gen_id }}">
    {% if block.settings.show_heading and block.settings.heading != blank %}
      <h2 class="ai-featured-collection-heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    {% if block.settings.collection != blank %}
      <div class="ai-featured-collection-grid-{{ ai_gen_id }}">
        {% for product in block.settings.collection.products limit: block.settings.product_count %}
          <a
            href="{{ product.url }}"
            class="ai-featured-collection-card-{{ ai_gen_id }}"
          >
            <div class="ai-featured-collection-image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-featured-collection-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="750"
                >
              {% else %}
                <div class="ai-featured-collection-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-featured-collection-info-{{ ai_gen_id }}">
              <h3 class="ai-featured-collection-title-{{ ai_gen_id }}">
                {{ product.title }}
              </h3>
              <div class="ai-featured-collection-price-{{ ai_gen_id }}">
                {{ product.price | money }}
              </div>
            </div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-featured-collection-grid-{{ ai_gen_id }}">
        {% for i in (1..4) %}
          <div class="ai-featured-collection-card-{{ ai_gen_id }}">
            <div class="ai-featured-collection-image-wrapper-{{ ai_gen_id }}">
              <div class="ai-featured-collection-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            </div>
            <div class="ai-featured-collection-info-{{ ai_gen_id }}">
              <h3 class="ai-featured-collection-title-{{ ai_gen_id }}">
                Product title
              </h3>
              <div class="ai-featured-collection-price-{{ ai_gen_id }}">
                R$ 0,00
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</featured-collection-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturedCollection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('featured-collection-{{ ai_gen_id }}', FeaturedCollection{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_count",
      "min": 2,
      "max": 8,
      "step": 2,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading text",
      "default": "Featured Collection"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
