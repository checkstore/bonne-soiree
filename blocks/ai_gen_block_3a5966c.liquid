{% doc %}
  @prompt
    Create a new footer section inspired by the Bonne Soirée aesthetic.
    
    Structure:
    
    4 columns total.
    
    Column 1: logo da marca.
    
    Column 2: “Institucional” (links: Quem somos, Trabalhe conosco, Pontos de venda).
    
    Column 3: “Ajuda e suporte” (links: Trocas e devoluções, Política de privacidade, Termos de serviço, Meus pedidos).
    
    Column 4: “Atendimento” (e-mail, telefone, endereço e horários).
    
    À direita, uma área de newsletter com título “Bienvenue à Bonne Soirée” e campo de e-mail com botão com borda fina (igual ao botão editorial do site).
    
    Style:
    
    Fundo off-white (#F9F8F5).
    
    Tipografia serifada (Times New Roman ou similar).
    
    Linhas finas, espaçamento generoso e alinhamento central elegante.
    
    Créditos e métodos de pagamento na parte inferior, separados por uma linha fina.
    
    Responsividade:
    
    Empilhar colunas no mobile em uma única coluna, com espaçamento equilibrado.
    
    Newsletter centralizada abaixo das seções.
    
    A estética deve ser minimalista, editorial e sofisticada, consistente com o restante do site., Create a new footer section inspired by the Bonne Soirée aesthetic.
    
    Structure:
    
    4 columns total.
    
    Column 1: logo da marca.
    
    Column 2: “Institucional” (links: Quem somos, Trabalhe conosco, Pontos de venda).
    
    Column 3: “Ajuda e suporte” (links: Trocas e devoluções, Política de privacidade, Termos de serviço, Meus pedidos).
    
    Column 4: “Atendimento” (e-mail, telefone, endereço e horários).
    
    À direita, uma área de newsletter com título “Bienvenue à Bonne Soirée” e campo de e-mail com botão com borda fina (igual ao botão editorial do site).
    
    Style:
    
    Fundo off-white (#F9F8F5).
    
    Tipografia serifada (Times New Roman ou similar).
    
    Linhas finas, espaçamento generoso e alinhamento central elegante.
    
    Créditos e métodos de pagamento na parte inferior, separados por uma linha fina.
    
    Responsividade:
    
    Empilhar colunas no mobile em uma única coluna, com espaçamento equilibrado.
    
    Newsletter centralizada abaixo das seções.
    
    A estética deve ser minimalista, editorial e sofisticada, consistente com o restante do site., Remove all bold styling from the footer section.
    Apply a consistent regular weight (400) for every text element — including headings, links, and form labels.
    , In the “Ajuda e suporte” column, add two new links:
    
    Meus pedidos
    
    Cashback
    
    Then, slightly reduce the font size of all the smaller link items (those under the main column titles like “Atendimento” or “Institucional”).
    Suggested size: around 14px desktop / 13px mobile, keeping Times New Roman and regular weight.
    Do not change the column titles or the “Bienvenue à Bonne Soirée” section.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
    font-family: {{ block.settings.font_family.family }}, serif;
    color: {{ block.settings.text_color }};
  }

  .ai-footer-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-footer-main-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr) 1.2fr;
    gap: {{ block.settings.column_gap }}px;
    margin-bottom: {{ block.settings.bottom_spacing }}px;
  }

  .ai-footer-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.link_spacing }}px;
  }

  .ai-footer-logo-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
  }

  .ai-footer-logo-{{ ai_gen_id }} img {
    max-width: {{ block.settings.logo_width }}px;
    height: auto;
  }

  .ai-footer-logo-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.logo_width }}px;
    height: 60px;
    background-color: #e8e8e8;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .ai-footer-logo-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 80px;
    max-height: 40px;
  }

  .ai-footer-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 400;
    margin-bottom: {{ block.settings.title_margin }}px;
    color: {{ block.settings.title_color }};
    letter-spacing: 0.5px;
  }

  .ai-footer-link-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    text-decoration: none;
    font-size: {{ block.settings.link_size }}px;
    font-weight: 400;
    line-height: 1.6;
    transition: color 0.3s ease;
  }

  .ai-footer-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-footer-contact-info-{{ ai_gen_id }} {
    font-size: {{ block.settings.contact_size }}px;
    font-weight: 400;
    line-height: 1.6;
    color: {{ block.settings.contact_color }};
  }

  .ai-footer-newsletter-{{ ai_gen_id }} {
    padding-left: {{ block.settings.newsletter_padding }}px;
    border-left: {{ block.settings.divider_thickness }}px solid {{ block.settings.divider_color }};
  }

  .ai-footer-newsletter-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.newsletter_title_size }}px;
    font-weight: 400;
    margin-bottom: {{ block.settings.newsletter_spacing }}px;
    color: {{ block.settings.newsletter_title_color }};
    font-style: italic;
    letter-spacing: 0.3px;
  }

  .ai-footer-newsletter-form-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-footer-newsletter-input-{{ ai_gen_id }} {
    flex: 1;
    padding: {{ block.settings.input_padding }}px;
    border: {{ block.settings.input_border_thickness }}px solid {{ block.settings.input_border_color }};
    background-color: transparent;
    font-family: inherit;
    font-size: {{ block.settings.input_size }}px;
    font-weight: 400;
    color: {{ block.settings.text_color }};
    border-radius: 0;
  }

  .ai-footer-newsletter-input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.placeholder_color }};
    font-style: italic;
    font-weight: 400;
  }

  .ai-footer-newsletter-input-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.input_focus_color }};
  }

  .ai-footer-newsletter-button-{{ ai_gen_id }} {
    padding: {{ block.settings.input_padding }}px {{ block.settings.button_padding }}px;
    border: {{ block.settings.button_border_thickness }}px solid {{ block.settings.button_border_color }};
    background-color: transparent;
    color: {{ block.settings.button_text_color }};
    font-family: inherit;
    font-size: {{ block.settings.button_size }}px;
    font-weight: 400;
    cursor: pointer;
    transition: all 0.3s ease;
    border-radius: 0;
    letter-spacing: 0.5px;
  }

  .ai-footer-newsletter-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg }};
    color: {{ block.settings.button_hover_text }};
  }

  .ai-footer-divider-{{ ai_gen_id }} {
    height: {{ block.settings.divider_thickness }}px;
    background-color: {{ block.settings.divider_color }};
    margin: {{ block.settings.divider_margin }}px 0;
  }

  .ai-footer-bottom-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
  }

  .ai-footer-credits-{{ ai_gen_id }} {
    font-size: {{ block.settings.credits_size }}px;
    font-weight: 400;
    color: {{ block.settings.credits_color }};
    letter-spacing: 0.3px;
  }

  .ai-footer-payment-methods-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .ai-footer-payment-icon-{{ ai_gen_id }} {
    width: {{ block.settings.payment_icon_size }}px;
    height: auto;
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }

  .ai-footer-payment-icon-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-footer-success-{{ ai_gen_id }} {
    color: {{ block.settings.success_color }};
    font-size: {{ block.settings.input_size }}px;
    font-weight: 400;
    margin-top: 8px;
    font-style: italic;
  }

  .ai-footer-error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
    font-size: {{ block.settings.input_size }}px;
    font-weight: 400;
    margin-top: 8px;
  }

  @media screen and (max-width: 1024px) {
    .ai-footer-main-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-footer-newsletter-{{ ai_gen_id }} {
      grid-column: 1 / -1;
      padding-left: 0;
      border-left: none;
      border-top: {{ block.settings.divider_thickness }}px solid {{ block.settings.divider_color }};
      padding-top: {{ block.settings.mobile_gap }}px;
      margin-top: {{ block.settings.mobile_gap }}px;
      text-align: center;
    }
  }

  @media screen and (max-width: 768px) {
    .ai-footer-main-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .ai-footer-logo-{{ ai_gen_id }} {
      justify-content: center;
      margin-bottom: {{ block.settings.mobile_spacing }}px;
    }

    .ai-footer-newsletter-form-{{ ai_gen_id }} {
      flex-direction: column;
      max-width: 300px;
      margin: 0 auto;
    }

    .ai-footer-bottom-{{ ai_gen_id }} {
      flex-direction: column;
      text-align: center;
    }

    .ai-footer-payment-methods-{{ ai_gen_id }} {
      justify-content: center;
    }

    .ai-footer-link-{{ ai_gen_id }} {
      font-size: 13px;
    }

    .ai-footer-contact-info-{{ ai_gen_id }} {
      font-size: 13px;
    }
  }
{% endstyle %}

<footer class="ai-footer-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-footer-container-{{ ai_gen_id }}">
    <div class="ai-footer-main-{{ ai_gen_id }}">
      <div class="ai-footer-column-{{ ai_gen_id }}">
        <div class="ai-footer-logo-{{ ai_gen_id }}">
          {% if block.settings.logo %}
            <img
              src="{{ block.settings.logo | image_url: width: 400 }}"
              alt="{{ shop.name }}"
              width="{{ block.settings.logo_width }}"
              height="auto"
              loading="lazy"
            >
          {% else %}
            <div class="ai-footer-logo-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ai-footer-column-{{ ai_gen_id }}">
        <h3 class="ai-footer-title-{{ ai_gen_id }}">{{ block.settings.institutional_title }}</h3>
        {% if block.settings.about_link %}
          <a href="{{ block.settings.about_link }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.about_text }}</a>
        {% endif %}
        {% if block.settings.careers_link %}
          <a href="{{ block.settings.careers_link }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.careers_text }}</a>
        {% endif %}
        {% if block.settings.stores_link %}
          <a href="{{ block.settings.stores_link }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.stores_text }}</a>
        {% endif %}
      </div>

      <div class="ai-footer-column-{{ ai_gen_id }}">
        <h3 class="ai-footer-title-{{ ai_gen_id }}">{{ block.settings.support_title }}</h3>
        {% if block.settings.returns_link %}
          <a href="{{ block.settings.returns_link }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.returns_text }}</a>
        {% endif %}
        {% if block.settings.privacy_link %}
          <a href="{{ block.settings.privacy_link }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.privacy_text }}</a>
        {% endif %}
        {% if block.settings.terms_link %}
          <a href="{{ block.settings.terms_link }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.terms_text }}</a>
        {% endif %}
        {% if block.settings.orders_link %}
          <a href="{{ block.settings.orders_link }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.orders_text }}</a>
        {% endif %}
        {% if block.settings.cashback_link %}
          <a href="{{ block.settings.cashback_link }}" class="ai-footer-link-{{ ai_gen_id }}">{{ block.settings.cashback_text }}</a>
        {% endif %}
      </div>

      <div class="ai-footer-column-{{ ai_gen_id }}">
        <h3 class="ai-footer-title-{{ ai_gen_id }}">{{ block.settings.contact_title }}</h3>
        <div class="ai-footer-contact-info-{{ ai_gen_id }}">
          {% if block.settings.contact_email %}
            <div>{{ block.settings.contact_email }}</div>
          {% endif %}
          {% if block.settings.contact_phone %}
            <div>{{ block.settings.contact_phone }}</div>
          {% endif %}
          {% if block.settings.contact_address %}
            <div>{{ block.settings.contact_address }}</div>
          {% endif %}
          {% if block.settings.contact_hours %}
            <div>{{ block.settings.contact_hours }}</div>
          {% endif %}
        </div>
      </div>

      <div class="ai-footer-newsletter-{{ ai_gen_id }}" style="max-width: 360px;">
        <h3 class="ai-footer-newsletter-title-{{ ai_gen_id }}">{{ block.settings.newsletter_title }}</h3>
        {% form 'customer' %}
          <div class="ai-footer-newsletter-form-{{ ai_gen_id }}" style="display: flex
;
    flex-direction: column;gap: 12px;">
            <input
              type="email"
              name="contact[email]"
              class="ai-footer-newsletter-input-{{ ai_gen_id }}"
              placeholder="{{ block.settings.email_placeholder }}"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="ai-footer-newsletter-error-{{ ai_gen_id }}"
              {% endif %}
              {% if form.posted_successfully? %}
                aria-describedby="ai-footer-newsletter-success-{{ ai_gen_id }}"
              {% endif %}
              required
            >
              <input
              type="number"
              name="contact[number]"
              class="ai-footer-newsletter-input-{{ ai_gen_id }}"
              placeholder="Seu WhatsApp"
              value="{{ form.number }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="number"
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="ai-footer-newsletter-error-{{ ai_gen_id }}"
              {% endif %}
              {% if form.posted_successfully? %}
                aria-describedby="ai-footer-newsletter-success-{{ ai_gen_id }}"
              {% endif %}
              required
            >
            <button type="submit" class="ai-footer-newsletter-button-{{ ai_gen_id }}">
              {{ block.settings.button_text }}
            </button>
          </div>
          {% if form.errors %}
            <div id="ai-footer-newsletter-error-{{ ai_gen_id }}" class="ai-footer-error-{{ ai_gen_id }}">
              {{ form.errors.messages.email }}
            </div>
          {% endif %}
          {% if form.posted_successfully? %}
            <div id="ai-footer-newsletter-success-{{ ai_gen_id }}" class="ai-footer-success-{{ ai_gen_id }}">
              {{ block.settings.success_message }}
            </div>
          {% endif %}
        {% endform %}
      </div>
    </div>

    <div class="ai-footer-divider-{{ ai_gen_id }}"></div>

    <div class="ai-footer-bottom-{{ ai_gen_id }}">
      <div class="ai-footer-credits-{{ ai_gen_id }}">
        {{ block.settings.copyright_text }}
      </div>
      
      {% if block.settings.show_payment_methods %}
        <div class="ai-footer-payment-methods-{{ ai_gen_id }}">
          {% for i in (1..6) %}
            {% assign payment_key = 'payment_icon_' | append: i %}
            {% if block.settings[payment_key] %}
              <img
                src="{{ block.settings[payment_key] | image_url: width: 100 }}"
                alt="Método de pagamento"
                class="ai-footer-payment-icon-{{ ai_gen_id }}"
                loading="lazy"
              >
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</footer>

