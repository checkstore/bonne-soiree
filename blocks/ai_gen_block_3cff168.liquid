    Schema settings
    
    heading, subheading, alignment, layout, max_items, show_clear_history, hide_when_empty., Adjustments required:
    
    Enforce a 3:4 aspect ratio for all product images (same ratio used in the brand’s main product grids).
    
    Crop or contain images within that ratio without distortion; maintain soft rounded corners.
    
    The price layout must follow the same visual hierarchy as the product grid/landing page:
    
    Product title: Times New Roman, regular, 16px, color #121212, normal case.
    
    Price: below the title, smaller font (14px), Times New Roman, regular, color #121212, line-height tight, no bold, aligned with the title.
    
    Ensure spacing between image, title, and price matches the brand’s product grid spacing.
    
    Keep hover behavior, shadows, and responsiveness as before.
    
    Do not change any logic or functionality — only visual presentation., Refine the “Recently Viewed Products” section for better visual consistency and spacing.
    
    1. Spacing adjustments
    
    Add more white space above the section so it feels visually separated from the product page content.
    
    Default: 80px top padding on desktop, 40px on mobile.
    
    Keep bottom spacing balanced (around 60px).
    
    Include these paddings as adjustable schema settings (padding_top, padding_bottom) so they can be changed later in the editor.
    
    2. Typography adjustments
    
    Apply Times New Roman font to both product titles and prices (scoped inside this section only).
    
    Titles: 16px, weight 400, color #121212.
    
    Prices: 14px, weight 400 (no bold), color #121212, aligned and spaced like the main product grid.
    
    Ensure the section does not inherit the theme’s body font (Heebo).
    
    Maintain all hover effects, image ratio (3:4), and layout behavior exactly as before.
    
    Goal: keep the same clean, editorial look as the main product grids on the site, with consistent spacing and typography.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-recently-viewed-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px 0;
    background-color: #ffffff;
    font-family: 'Times New Roman', serif;
  }

  .ai-recently-viewed-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-recently-viewed-header-{{ ai_gen_id }} {
    margin-bottom: 32px;
    text-align: {{ block.settings.alignment }};
  }

  .ai-recently-viewed-title-{{ ai_gen_id }} {
    font-family: 'Times New Roman', serif;
    font-size: 28px;
    font-weight: 400;
    color: #121212;
    margin: 0 0 8px 0;
    line-height: 1.2;
  }

  .ai-recently-viewed-subtitle-{{ ai_gen_id }} {
    font-family: 'Times New Roman', serif;
    font-size: 16px;
    font-weight: 400;
    color: #666;
    margin: 0;
    line-height: 1.4;
  }

  .ai-recently-viewed-clear-{{ ai_gen_id }} {
    margin-top: 12px;
  }

  .ai-recently-viewed-clear-link-{{ ai_gen_id }} {
    font-family: 'Times New Roman', serif;
    font-size: 14px;
    color: #666;
    text-decoration: underline;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
  }

  .ai-recently-viewed-clear-link-{{ ai_gen_id }}:hover {
    color: #121212;
  }

  .ai-recently-viewed-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: #666;
    font-family: 'Times New Roman', serif;
    font-size: 16px;
    font-weight: 400;
  }

  .ai-recently-viewed-grid-{{ ai_gen_id }} {
    display: grid;
    gap: 24px;
    grid-template-columns: repeat(2, 1fr);
  }

  .ai-recently-viewed-carousel-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-recently-viewed-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: 24px;
    transition: transform 0.3s ease;
  }

  .ai-recently-viewed-product-{{ ai_gen_id }} {
    flex: 0 0 auto;
    text-decoration: none;
    color: inherit;
    display: block;
    border-radius: 6px;
    overflow: hidden;
    transition: box-shadow 0.3s ease;
  }

  .ai-recently-viewed-product-{{ ai_gen_id }}:hover {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  .ai-recently-viewed-product-image-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 3/4;
    overflow: hidden;
    background-color: #f8f8f8;
    border-radius: 6px;
  }

  .ai-recently-viewed-product-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease;
  }

  .ai-recently-viewed-product-image-secondary-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-recently-viewed-product-{{ ai_gen_id }}:hover .ai-recently-viewed-product-image-secondary-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-recently-viewed-product-info-{{ ai_gen_id }} {
    padding: 12px 0 0 0;
  }

  .ai-recently-viewed-product-title-{{ ai_gen_id }} {
    font-family: 'Times New Roman', serif !important;
    font-size: 16px;
    font-weight: 400 !important;
    color: #121212;
    margin: 0 0 4px 0;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ai-recently-viewed-product-price-{{ ai_gen_id }} {
    font-family: 'Times New Roman', serif !important;
    font-size: 14px;
    font-weight: 400 !important;
    color: #121212;
    margin: 0;
    line-height: 1.2;
  }

  .ai-recently-viewed-carousel-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.9);
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.4;
    transition: opacity 0.3s ease;
    z-index: 2;
  }

  .ai-recently-viewed-carousel-nav-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-recently-viewed-carousel-nav-prev-{{ ai_gen_id }} {
    left: -20px;
  }

  .ai-recently-viewed-carousel-nav-next-{{ ai_gen_id }} {
    right: -20px;
  }

  .ai-recently-viewed-carousel-dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 24px;
  }

  .ai-recently-viewed-carousel-dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #ccc;
    border: none;
    cursor: pointer;
    opacity: 0.4;
    transition: opacity 0.3s ease;
  }

  .ai-recently-viewed-carousel-dot-{{ ai_gen_id }}.active {
    opacity: 0.7;
    background-color: #121212;
  }

  @media screen and (min-width: 750px) {
    .ai-recently-viewed-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.desktop_columns }}, 1fr);
    }

    .ai-recently-viewed-product-{{ ai_gen_id }} {
      width: calc((100% - {{ block.settings.desktop_items | minus: 1 | times: 24 }}px) / {{ block.settings.desktop_items }});
    }
  }

  @media screen and (max-width: 749px) {
    .ai-recently-viewed-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.5 }}px 0 {{ block.settings.padding_bottom }}px 0;
    }

    .ai-recently-viewed-title-{{ ai_gen_id }} {
      font-size: 24px;
    }

    .ai-recently-viewed-subtitle-{{ ai_gen_id }} {
      font-size: 14px;
    }

    .ai-recently-viewed-product-{{ ai_gen_id }} {
      width: calc((100% - {{ block.settings.mobile_items | minus: 1 | times: 16 }}px) / {{ block.settings.mobile_items }});
    }

    .ai-recently-viewed-carousel-track-{{ ai_gen_id }} {
      gap: 16px;
    }

    .ai-recently-viewed-product-info-{{ ai_gen_id }} {
      padding: 8px 0 0 0;
    }

    .ai-recently-viewed-product-title-{{ ai_gen_id }} {
      font-size: 14px;
    }

    .ai-recently-viewed-product-price-{{ ai_gen_id }} {
      font-size: 12px;
    }
  }

  .ai-recently-viewed-hidden-{{ ai_gen_id }} {
    display: none;
  }
{% endstyle %}

<recently-viewed-products-{{ ai_gen_id }}
  class="ai-recently-viewed-{{ ai_gen_id }}"
  data-max-items="{{ block.settings.max_items }}"
  data-layout="{{ block.settings.layout }}"
  data-hide-when-empty="{{ block.settings.hide_when_empty }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-recently-viewed-container-{{ ai_gen_id }}">
    <div class="ai-recently-viewed-header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-recently-viewed-title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      
      {% if block.settings.subheading != blank %}
        <p class="ai-recently-viewed-subtitle-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
      {% endif %}

      {% if block.settings.show_clear_history %}
        <div class="ai-recently-viewed-clear-{{ ai_gen_id }}">
          <button class="ai-recently-viewed-clear-link-{{ ai_gen_id }}" data-clear-history>
            Limpar histórico
          </button>
        </div>
      {% endif %}
    </div>

    <div class="ai-recently-viewed-empty-{{ ai_gen_id }}" data-empty-state>
      Nenhum produto visualizado ainda.
    </div>

    {% if block.settings.layout == 'grid' %}
      <div class="ai-recently-viewed-grid-{{ ai_gen_id }}" data-products-grid></div>
    {% else %}
      <div class="ai-recently-viewed-carousel-{{ ai_gen_id }}" data-carousel>
        <div class="ai-recently-viewed-carousel-track-{{ ai_gen_id }}" data-carousel-track></div>
        
        <button class="ai-recently-viewed-carousel-nav-{{ ai_gen_id }} ai-recently-viewed-carousel-nav-prev-{{ ai_gen_id }}" data-carousel-prev>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15,18 9,12 15,6"></polyline>
          </svg>
        </button>
        
        <button class="ai-recently-viewed-carousel-nav-{{ ai_gen_id }} ai-recently-viewed-carousel-nav-next-{{ ai_gen_id }}" data-carousel-next>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9,18 15,12 9,6"></polyline>
          </svg>
        </button>
        
        <div class="ai-recently-viewed-carousel-dots-{{ ai_gen_id }}" data-carousel-dots></div>
      </div>
    {% endif %}
  </div>
</recently-viewed-products-{{ ai_gen_id }}>

<script>
  (function() {
    class RecentlyViewedProducts{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.maxItems = parseInt(this.dataset.maxItems) || 6;
        this.layout = this.dataset.layout || 'grid';
        this.hideWhenEmpty = this.dataset.hideWhenEmpty === 'true';
        this.currentSlide = 0;
        this.products = [];
        this.storageKey = 'recently_viewed';
      }

      connectedCallback() {
        this.loadRecentlyViewed();
        this.setupEventListeners();
        this.trackCurrentProduct();
      }

      setupEventListeners() {
        const clearButton = this.querySelector('[data-clear-history]');
        if (clearButton) {
          clearButton.addEventListener('click', () => this.clearHistory());
        }

        if (this.layout === 'carousel') {
          const prevButton = this.querySelector('[data-carousel-prev]');
          const nextButton = this.querySelector('[data-carousel-next]');
          
          if (prevButton) prevButton.addEventListener('click', () => this.previousSlide());
          if (nextButton) nextButton.addEventListener('click', () => this.nextSlide());
        }
      }

      trackCurrentProduct() {
        if (window.location.pathname.includes('/products/')) {
          const productHandle = window.location.pathname.split('/products/')[1].split('?')[0];
          if (productHandle) {
            this.addToRecentlyViewed(productHandle);
          }
        }
      }

      addToRecentlyViewed(handle) {
        let recentlyViewed = this.getRecentlyViewed();
        
        recentlyViewed = recentlyViewed.filter(item => item !== handle);
        recentlyViewed.unshift(handle);
        recentlyViewed = recentlyViewed.slice(0, 12);
        
        localStorage.setItem(this.storageKey, JSON.stringify(recentlyViewed));
        this.loadRecentlyViewed();
      }

      getRecentlyViewed() {
        try {
          return JSON.parse(localStorage.getItem(this.storageKey) || '[]');
        } catch {
          return [];
        }
      }

      clearHistory() {
        localStorage.removeItem(this.storageKey);
        this.products = [];
        this.renderProducts();
      }

      async loadRecentlyViewed() {
        const handles = this.getRecentlyViewed();
        if (handles.length === 0) {
          this.renderProducts();
          return;
        }

        const currentProductHandle = window.location.pathname.includes('/products/') 
          ? window.location.pathname.split('/products/')[1].split('?')[0] 
          : null;

        const filteredHandles = handles.filter(handle => handle !== currentProductHandle);
        const displayHandles = filteredHandles.slice(0, this.maxItems);

        try {
          const productPromises = displayHandles.map(handle => this.fetchProduct(handle));
          const products = await Promise.all(productPromises);
          this.products = products.filter(product => product !== null);
          this.renderProducts();
        } catch (error) {
          console.error('Error loading recently viewed products:', error);
          this.renderProducts();
        }
      }

      async fetchProduct(handle) {
        try {
          const locale = document.documentElement.lang || 'pt-BR';
          const localePrefix = locale !== 'pt-BR' ? `/${locale}` : '';
          const response = await fetch(`${localePrefix}/products/${handle}.js`);
          
          if (!response.ok) throw new Error('Product not found');
          
          return await response.json();
        } catch (error) {
          console.error(`Error fetching product ${handle}:`, error);
          return null;
        }
      }

      renderProducts() {
        const emptyState = this.querySelector('[data-empty-state]');
        const grid = this.querySelector('[data-products-grid]');
        const carousel = this.querySelector('[data-carousel]');

        if (this.products.length === 0) {
          if (emptyState) emptyState.style.display = 'block';
          if (grid) grid.style.display = 'none';
          if (carousel) carousel.style.display = 'none';
          
          if (this.hideWhenEmpty) {
            this.style.display = 'none';
          }
          return;
        }

        if (emptyState) emptyState.style.display = 'none';
        this.style.display = 'block';

        if (this.layout === 'grid') {
          this.renderGrid();
        } else {
          this.renderCarousel();
        }
      }

      renderGrid() {
        const grid = this.querySelector('[data-products-grid]');
        if (!grid) return;

        grid.style.display = 'grid';
        grid.innerHTML = this.products.map(product => this.createProductHTML(product)).join('');
      }

      renderCarousel() {
        const carousel = this.querySelector('[data-carousel]');
        const track = this.querySelector('[data-carousel-track]');
        if (!carousel || !track) return;

        carousel.style.display = 'block';
        track.innerHTML = this.products.map(product => this.createProductHTML(product)).join('');
        
        this.setupCarouselNavigation();
      }

      createProductHTML(product) {
        const primaryImage = product.featured_image || (product.images && product.images[0]);
        const secondaryImage = product.images && product.images[1];
        const price = this.formatPrice(product.price);

        return `
          <a href="/products/${product.handle}" class="ai-recently-viewed-product-{{ ai_gen_id }}">
            <div class="ai-recently-viewed-product-image-{{ ai_gen_id }}">
              ${primaryImage ? `<img src="${primaryImage}" alt="${product.title}" loading="lazy">` : ''}
              ${secondaryImage ? `<img src="${secondaryImage}" alt="${product.title}" class="ai-recently-viewed-product-image-secondary-{{ ai_gen_id }}" loading="lazy">` : ''}
            </div>
            <div class="ai-recently-viewed-product-info-{{ ai_gen_id }}">
              <h3 class="ai-recently-viewed-product-title-{{ ai_gen_id }}">${product.title}</h3>
              <p class="ai-recently-viewed-product-price-{{ ai_gen_id }}">${price}</p>
            </div>
          </a>
        `;
      }

      formatPrice(price) {
        return new Intl.NumberFormat('pt-BR', {
          style: 'currency',
          currency: 'BRL'
        }).format(price / 100);
      }

      setupCarouselNavigation() {
        const track = this.querySelector('[data-carousel-track]');
        const prevButton = this.querySelector('[data-carousel-prev]');
        const nextButton = this.querySelector('[data-carousel-next]');
        const dotsContainer = this.querySelector('[data-carousel-dots]');

        if (!track) return;

        const isMobile = window.innerWidth < 750;
        const itemsPerSlide = isMobile ? {{ block.settings.mobile_items }} : {{ block.settings.desktop_items }};
        const totalSlides = Math.ceil(this.products.length / itemsPerSlide);

        if (totalSlides <= 1) {
          if (prevButton) prevButton.style.display = 'none';
          if (nextButton) nextButton.style.display = 'none';
          if (dotsContainer) dotsContainer.style.display = 'none';
          return;
        }

        if (prevButton) prevButton.style.display = 'flex';
        if (nextButton) nextButton.style.display = 'flex';

        if (dotsContainer) {
          dotsContainer.style.display = 'flex';
          dotsContainer.innerHTML = Array.from({ length: totalSlides }, (_, i) => 
            `<button class="ai-recently-viewed-carousel-dot-{{ ai_gen_id }} ${i === 0 ? 'active' : ''}" data-slide="${i}"></button>`
          ).join('');

          dotsContainer.addEventListener('click', (e) => {
            if (e.target.dataset.slide !== undefined) {
              this.goToSlide(parseInt(e.target.dataset.slide));
            }
          });
        }

        this.updateCarouselPosition();
      }

      previousSlide() {
        const isMobile = window.innerWidth < 750;
        const itemsPerSlide = isMobile ? {{ block.settings.mobile_items }} : {{ block.settings.desktop_items }};
        const totalSlides = Math.ceil(this.products.length / itemsPerSlide);
        
        this.currentSlide = this.currentSlide > 0 ? this.currentSlide - 1 : totalSlides - 1;
        this.updateCarouselPosition();
      }

      nextSlide() {
        const isMobile = window.innerWidth < 750;
        const itemsPerSlide = isMobile ? {{ block.settings.mobile_items }} : {{ block.settings.desktop_items }};
        const totalSlides = Math.ceil(this.products.length / itemsPerSlide);
        
        this.currentSlide = this.currentSlide < totalSlides - 1 ? this.currentSlide + 1 : 0;
        this.updateCarouselPosition();
      }

      goToSlide(slideIndex) {
        this.currentSlide = slideIndex;
        this.updateCarouselPosition();
      }

      updateCarouselPosition() {
        const track = this.querySelector('[data-carousel-track]');
        const dots = this.querySelectorAll('[data-carousel-dots] button');
        
        if (!track) return;

        const isMobile = window.innerWidth < 750;
        const itemsPerSlide = isMobile ? {{ block.settings.mobile_items }} : {{ block.settings.desktop_items }};
        const itemWidth = isMobile ? `calc((100% - ${itemsPerSlide - 1} * 16px) / ${itemsPerSlide})` : `calc((100% - ${itemsPerSlide - 1} * 24px) / ${itemsPerSlide})`;
        const gap = isMobile ? 16 : 24;
        const slideWidth = 100 / itemsPerSlide;
        const translateX = -(this.currentSlide * slideWidth * itemsPerSlide);

        track.style.transform = `translateX(${translateX}%)`;

        dots.forEach((dot, index) => {
          dot.classList.toggle('active', index === this.currentSlide);
        });
      }
    }

    customElements.define('recently-viewed-products-{{ ai_gen_id }}', RecentlyViewedProducts{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Recently Viewed Products",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently Viewed"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Products you've recently browsed"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
