{% doc %}
  @prompt
    Crie uma Announcement Bar personalizada para Shopify (compatível com temas OS 2.0) com as seguintes características:
    Barra de anúncio estática (sem animação ou rolagem)
    Bloco sólido de cor (background único)
    Texto centralizado horizontal e verticalmente
    Opções totalmente editáveis no editor do tema:
    Cor de fundo da barra
    Cor do texto
    Tamanho da fonte (ex: pequeno, médio, grande ou em px)
    Tipo de fonte (usar fontes padrão do tema ou permitir seleção)
    Texto da announcement bar
    Layout responsivo (desktop e mobile)
    Altura da barra ajustável automaticamente conforme o tamanho da fonte
    Código limpo, bem comentado e seguindo boas práticas do Shopify (Liquid + CSS)
    Não deve afetar o header nem causar layout shift no site
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-bar-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.vertical_padding }}px 20px;
  }

  .ai-announcement-bar-content-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-announcement-bar-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    font-family: {{ block.settings.font_family.family }}, {{ block.settings.font_family.fallback_families }};
    font-weight: {{ block.settings.font_family.weight }};
    font-style: {{ block.settings.font_family.style }};
    margin: 0;
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-bar-{{ ai_gen_id }} {
      padding: {{ block.settings.vertical_padding | times: 0.8 }}px 15px;
    }

    .ai-announcement-bar-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<announcement-bar-{{ ai_gen_id }}
  class="ai-announcement-bar-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-announcement-bar-content-{{ ai_gen_id }}">
    <p class="ai-announcement-bar-text-{{ ai_gen_id }}">
      {{ block.settings.announcement_text }}
    </p>
  </div>
</announcement-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class AnnouncementBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('announcement-bar-{{ ai_gen_id }}', AnnouncementBar{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Barra de anúncio",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Conteúdo"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Texto do anúncio",
      "default": "Frete grátis para compras acima de R$ 300"
    },
    {
      "type": "header",
      "content": "Cores"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Cor de fundo",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do texto",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Tipografia"
    },
    {
      "type": "font_picker",
      "id": "font_family",
      "label": "Fonte",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Tamanho da fonte",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Espaçamento vertical",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Largura no desktop",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Barra de anúncio"
    }
  ]
}
{% endschema %}
