{% doc %}
  @prompt
    Create a new image banner section with an editorial framed layout.
    The image must keep its original aspect ratio and never be cropped (use object-fit: contain).
    The banner should be displayed over an off-white background (#F9F8F5), with the image centered and surrounded by even padding on all sides, creating the effect of an elegant frame.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-banner-{{ ai_gen_id }} {
    background-color: {{ block.settings.frame_background_color }};
    padding: {{ block.settings.frame_padding }}px;
    width: 100%;
    max-width: 100%;
  }

  .ai-editorial-banner__container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-editorial-banner__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.banner_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    box-shadow: 0 {{ block.settings.shadow_vertical }}px {{ block.settings.shadow_blur }}px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
  }

  .ai-editorial-banner__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .ai-editorial-banner__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-editorial-banner__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
    opacity: 0.3;
  }

  .ai-editorial-banner__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 6px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-editorial-banner__content-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: {{ block.settings.content_vertical_alignment }};
    justify-content: {{ block.settings.content_horizontal_alignment }};
    padding: 40px;
    z-index: 2;
  }

  .ai-editorial-banner__content-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    max-width: {{ block.settings.content_max_width }}px;
    background-color: {{ block.settings.content_background_color }};
    padding: {{ block.settings.content_padding }}px;
    border-radius: {{ block.settings.content_border_radius }}px;
    backdrop-filter: blur({{ block.settings.content_backdrop_blur }}px);
  }

  .ai-editorial-banner__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px 0;
    line-height: 1.2;
  }

  .ai-editorial-banner__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
    margin: 0 0 {{ block.settings.text_margin_bottom }}px 0;
  }

  .ai-editorial-banner__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
  }

  .ai-editorial-banner__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-banner-{{ ai_gen_id }} {
      padding: {{ block.settings.frame_padding | times: 0.6 }}px;
    }

    .ai-editorial-banner__image-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.banner_height | times: 0.7 }}px;
    }

    .ai-editorial-banner__content-overlay-{{ ai_gen_id }} {
      padding: 20px;
    }

    .ai-editorial-banner__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-editorial-banner__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-editorial-banner__button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
      padding: {{ block.settings.button_padding_vertical | times: 0.8 }}px {{ block.settings.button_padding_horizontal | times: 0.8 }}px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-editorial-banner__content-{{ ai_gen_id }} {
      max-width: 100%;
    }
  }
{% endstyle %}

<div
  class="ai-editorial-banner-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-editorial-banner__container-{{ ai_gen_id }}">
    <div class="ai-editorial-banner__image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 2000 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-editorial-banner__image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-editorial-banner__placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-editorial-banner__empty-state-{{ ai_gen_id }}">
            Adicione uma imagem para começar
          </div>
        </div>
      {% endif %}

      {% liquid
        assign show_overlay = false
        if block.settings.show_content_overlay
          if block.settings.heading != blank or block.settings.text != blank or block.settings.button_text != blank
            assign show_overlay = true
          endif
        endif
      %}

      {% if show_overlay %}
        <div class="ai-editorial-banner__content-overlay-{{ ai_gen_id }}">
          <div class="ai-editorial-banner__content-{{ ai_gen_id }}">
            {% if block.settings.heading != blank %}
              <h2 class="ai-editorial-banner__heading-{{ ai_gen_id }}">
                {{ block.settings.heading }}
              </h2>
            {% endif %}

            {% if block.settings.text != blank %}
              <div class="ai-editorial-banner__text-{{ ai_gen_id }}">
                {{ block.settings.text }}
              </div>
            {% endif %}

            {% if block.settings.button_text != blank and block.settings.button_link != blank %}
              <a
                href="{{ block.settings.button_link }}"
                class="ai-editorial-banner__button-{{ ai_gen_id }}"
              >
                {{ block.settings.button_text }}
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial framed banner",
  "tag": null,
  "settings": [
