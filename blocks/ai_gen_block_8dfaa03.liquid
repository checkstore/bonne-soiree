      "min": 16,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Title font size",
      "default": 48
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "font_picker",
      "id": "subtitle_font",
      "label": "Subtitle font",
