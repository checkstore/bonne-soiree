{% doc %}
  @prompt
    Create a new section named “Footer Bottom Bar”.
    
    Content:
    
    Left:
    “Bonne Soirée Comércio de Vestuário LTDA – 46.079.622/0001-58 | Rua Bela Cintra, 2116 – Jardim Paulista, São Paulo, SP”
    
    Center: icons of accepted payment methods (Visa, Mastercard, Amex, PayPal, Pix, etc.) — allow upload or use theme icons.
    
    Right: small social media icons (Instagram, TikTok) with editable links.
    
    Bottom line:
    “© 2025 Bonne Soirée – Todos os direitos reservados. Desenvolvido por Shakers.”
    
    Layout:
    
    Desktop: 3 columns — Left | Center | Right.
    
    Mobile: stack vertically in order (company info → payment icons → social icons → fine print).
    
    Add a thin top border (1px solid #EAEAEA).
    
    Padding: 24px desktop / 16px mobile.
    
    Typography:
    
    Font family: "Times New Roman", serif.
    
    Font weight: 400 (regular).
    
    Font size: ~13–14px.
    
    Color: soft gray (#666666).
    
    Style:
    Minimal, editorial, and consistent with the existing Bonne Soirée footer aesthetic.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-bottom-bar-{{ ai_gen_id }} {
    border-top: 1px solid #EAEAEA;
    padding: 24px;
    font-family: "Times New Roman", serif;
    font-weight: 400;
    font-size: 14px;
    color: #666666;
    line-height: 1.4;
  }

  .ai-footer-bottom-bar__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-footer-bottom-bar__main-content-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    margin-bottom: 16px;
  }

  .ai-footer-bottom-bar__company-info-{{ ai_gen_id }} {
    font-size: 13px;
  }

  .ai-footer-bottom-bar__payment-icons-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .ai-footer-bottom-bar__payment-icon-{{ ai_gen_id }} {
    width: 32px;
    height: 20px;
    object-fit: contain;
    opacity: 0.8;
  }

  .ai-footer-bottom-bar__payment-icon-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-footer-bottom-bar__social-icons-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
  }

  .ai-footer-bottom-bar__social-link-{{ ai_gen_id }} {
    color: #666666;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .ai-footer-bottom-bar__social-link-{{ ai_gen_id }}:hover {
    color: #333333;
  }

  .ai-footer-bottom-bar__social-icon-{{ ai_gen_id }} {
    width: 18px;
    height: 18px;
  }

  .ai-footer-bottom-bar__copyright-{{ ai_gen_id }} {
    text-align: center;
    font-size: 13px;
    margin-top: 16px;
  }

  @media screen and (max-width: 749px) {
    .ai-footer-bottom-bar-{{ ai_gen_id }} {
      padding: 16px;
    }

    .ai-footer-bottom-bar__main-content-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 16px;
      margin-bottom: 16px;
    }

    .ai-footer-bottom-bar__social-icons-{{ ai_gen_id }} {
      justify-content: center;
    }

    .ai-footer-bottom-bar__payment-icons-{{ ai_gen_id }} {
      justify-content: center;
    }
  }

  .ai-footer-bottom-bar__payment-placeholder-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #999999;
    font-style: italic;
    font-size: 12px;
  }

  .ai-footer-bottom-bar__payment-placeholder-icon-{{ ai_gen_id }} {
    width: 32px;
    height: 20px;
    background-color: #f0f0f0;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    color: #999999;
  }
{% endstyle %}

<div class="ai-footer-bottom-bar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-footer-bottom-bar__container-{{ ai_gen_id }}">
    <div class="ai-footer-bottom-bar__main-content-{{ ai_gen_id }}">
      <div class="ai-footer-bottom-bar__company-info-{{ ai_gen_id }}">
        {{ block.settings.company_info }}
      </div>

      <div class="ai-footer-bottom-bar__payment-icons-{{ ai_gen_id }}">
        {% if block.settings.show_payment_icons %}
          {% if block.settings.visa_icon %}
            <img src="{{ block.settings.visa_icon | image_url: width: 64 }}" alt="Visa" class="ai-footer-bottom-bar__payment-icon-{{ ai_gen_id }}" loading="lazy">
          {% endif %}
          {% if block.settings.mastercard_icon %}
            <img src="{{ block.settings.mastercard_icon | image_url: width: 64 }}" alt="Mastercard" class="ai-footer-bottom-bar__payment-icon-{{ ai_gen_id }}" loading="lazy">
          {% endif %}
          {% if block.settings.amex_icon %}
            <img src="{{ block.settings.amex_icon | image_url: width: 64 }}" alt="American Express" class="ai-footer-bottom-bar__payment-icon-{{ ai_gen_id }}" loading="lazy">
          {% endif %}
          {% if block.settings.paypal_icon %}
            <img src="{{ block.settings.paypal_icon | image_url: width: 64 }}" alt="PayPal" class="ai-footer-bottom-bar__payment-icon-{{ ai_gen_id }}" loading="lazy">
          {% endif %}
          {% if block.settings.pix_icon %}
            <img src="{{ block.settings.pix_icon | image_url: width: 64 }}" alt="Pix" class="ai-footer-bottom-bar__payment-icon-{{ ai_gen_id }}" loading="lazy">
          {% endif %}
          {% if block.settings.custom_payment_icon_1 %}
            <img src="{{ block.settings.custom_payment_icon_1 | image_url: width: 64 }}" alt="{{ block.settings.custom_payment_alt_1 | default: 'Payment method' }}" class="ai-footer-bottom-bar__payment-icon-{{ ai_gen_id }}" loading="lazy">
          {% endif %}
          {% if block.settings.custom_payment_icon_2 %}
            <img src="{{ block.settings.custom_payment_icon_2 | image_url: width: 64 }}" alt="{{ block.settings.custom_payment_alt_2 | default: 'Payment method' }}" class="ai-footer-bottom-bar__payment-icon-{{ ai_gen_id }}" loading="lazy">
          {% endif %}
          {% if block.settings.custom_payment_icon_3 %}
            <img src="{{ block.settings.custom_payment_icon_3 | image_url: width: 64 }}" alt="{{ block.settings.custom_payment_alt_3 | default: 'Payment method' }}" class="ai-footer-bottom-bar__payment-icon-{{ ai_gen_id }}" loading="lazy">
          {% endif %}

          {% unless block.settings.visa_icon or block.settings.mastercard_icon or block.settings.amex_icon or block.settings.paypal_icon or block.settings.pix_icon or block.settings.custom_payment_icon_1 or block.settings.custom_payment_icon_2 or block.settings.custom_payment_icon_3 %}
            <div class="ai-footer-bottom-bar__payment-placeholder-{{ ai_gen_id }}">
              <div class="ai-footer-bottom-bar__payment-placeholder-icon-{{ ai_gen_id }}">VISA</div>
              <div class="ai-footer-bottom-bar__payment-placeholder-icon-{{ ai_gen_id }}">MC</div>
              <div class="ai-footer-bottom-bar__payment-placeholder-icon-{{ ai_gen_id }}">AMEX</div>
              <div class="ai-footer-bottom-bar__payment-placeholder-icon-{{ ai_gen_id }}">PIX</div>
              <span>Add payment icons</span>
            </div>
          {% endunless %}
        {% endif %}
      </div>

      <div class="ai-footer-bottom-bar__social-icons-{{ ai_gen_id }}">
        {% if block.settings.instagram_url != blank %}
          <a href="{{ block.settings.instagram_url }}" class="ai-footer-bottom-bar__social-link-{{ ai_gen_id }}" target="_blank" rel="noopener" aria-label="Instagram">
            <svg class="ai-footer-bottom-bar__social-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        {% endif %}

        {% if block.settings.tiktok_url != blank %}
          <a href="{{ block.settings.tiktok_url }}" class="ai-footer-bottom-bar__social-link-{{ ai_gen_id }}" target="_blank" rel="noopener" aria-label="TikTok">
            <svg class="ai-footer-bottom-bar__social-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
            </svg>
          </a>
        {% endif %}
      </div>
    </div>

    <div class="ai-footer-bottom-bar__copyright-{{ ai_gen_id }}">
      {{ block.settings.copyright_text }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Footer Bottom Bar",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Company information"
    },
    {
      "type": "textarea",
      "id": "company_info",
      "label": "Company information",
      "default": "Bonne Soirée Comércio de Vestuário LTDA – 46.079.622/0001-58 | Rua Bela Cintra, 2116 – Jardim Paulista, São Paulo, SP"
    },
    {
      "type": "header",
      "content": "Payment methods"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "visa_icon",
      "label": "Visa icon"
    },
    {
      "type": "image_picker",
      "id": "mastercard_icon",
      "label": "Mastercard icon"
    },
    {
      "type": "image_picker",
      "id": "amex_icon",
      "label": "American Express icon"
    },
    {
      "type": "image_picker",
      "id": "paypal_icon",
      "label": "PayPal icon"
    },
    {
      "type": "image_picker",
      "id": "pix_icon",
      "label": "Pix icon"
    },
    {
      "type": "image_picker",
      "id": "custom_payment_icon_1",
      "label": "Custom payment icon 1"
    },
    {
      "type": "text",
      "id": "custom_payment_alt_1",
      "label": "Custom payment icon 1 alt text"
    },
    {
      "type": "image_picker",
      "id": "custom_payment_icon_2",
      "label": "Custom payment icon 2"
    },
    {
      "type": "text",
      "id": "custom_payment_alt_2",
      "label": "Custom payment icon 2 alt text"
    },
    {
      "type": "image_picker",
      "id": "custom_payment_icon_3",
      "label": "Custom payment icon 3"
    },
    {
      "type": "text",
      "id": "custom_payment_alt_3",
      "label": "Custom payment icon 3 alt text"
    },
    {
      "type": "header",
      "content": "Social media"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "header",
      "content": "Copyright"
    },
    {
      "type": "textarea",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "© 2025 Bonne Soirée – Todos os direitos reservados. Desenvolvido por Shakers."
    }
  ],
  "presets": [
    {
      "name": "Footer Bottom Bar"
    }
  ]
}
{% endschema %}