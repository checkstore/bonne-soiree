{% doc %}
  @prompt
    Create a new section with a two-column editorial layout.
    The image should be aligned to the left and the text to the right, following a minimal and balanced composition (similar to an editorial magazine layout).
    
    Specifications:
    
    The image should maintain its original aspect ratio (object-fit: contain) and have subtle margins (not large gaps).
    
    The text column should be aligned vertically centered to the image height.
    
    Background color: #FFFFFF or #F9F8F5 (off-white).
    
    Font for the text: Times New Roman, regular weight, line-height around 1.6 for readability.
    
    The section should support rich text (title + paragraph).
    
    Keep the composition clean, with ample white space but not exaggerated — think of a printed magazine layout.
    
    On mobile, the image should stack above the text, keeping proportional spacing."
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-layout-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-editorial-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.horizontal_padding }}px;
  }

  .ai-editorial-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: center;
    min-height: {{ block.settings.min_height }}px;
  }

  .ai-editorial-image-column-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: {{ block.settings.image_padding }}px;
  }

  .ai-editorial-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
    position: relative;
  }

  .ai-editorial-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .ai-editorial-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4/3;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-editorial-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
    opacity: 0.3;
  }

  .ai-editorial-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
    font-family: 'Times New Roman', serif;
  }

  .ai-editorial-text-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: {{ block.settings.text_padding }}px;
  }

  .ai-editorial-title-{{ ai_gen_id }} {
    font-family: 'Times New Roman', serif;
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    line-height: {{ block.settings.title_line_height }};
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_margin }}px 0;
  }

  .ai-editorial-text-{{ ai_gen_id }} {
    font-family: 'Times New Roman', serif;
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    line-height: {{ block.settings.text_line_height }};
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-editorial-text-{{ ai_gen_id }} p {
    margin: 0 0 1em 0;
  }

  .ai-editorial-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  {% if block.settings.layout == 'image_right' %}
    .ai-editorial-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr 1fr;
    }
    
    .ai-editorial-image-column-{{ ai_gen_id }} {
      order: 2;
    }
    
    .ai-editorial-text-column-{{ ai_gen_id }} {
      order: 1;
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .ai-editorial-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
      min-height: auto;
    }

    .ai-editorial-image-column-{{ ai_gen_id }},
    .ai-editorial-text-column-{{ ai_gen_id }} {
      order: unset;
    }

    .ai-editorial-image-column-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_image_padding }}px;
    }

    .ai-editorial-text-column-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_text_padding }}px;
    }

    .ai-editorial-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_title_size }}px;
      margin-bottom: {{ block.settings.mobile_title_margin }}px;
    }

    .ai-editorial-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
    }

    .ai-editorial-container-{{ ai_gen_id }} {
      padding: 0 {{ block.settings.mobile_horizontal_padding }}px;
    }
  }
{% endstyle %}

<div
  class="ai-editorial-layout-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-editorial-container-{{ ai_gen_id }}">
    <div class="ai-editorial-grid-{{ ai_gen_id }}">
      <div class="ai-editorial-image-column-{{ ai_gen_id }}">
        <div class="ai-editorial-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.image %}
            <img
              src="{{ block.settings.image | image_url: width: 1200 }}"
              alt="{{ block.settings.image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              class="ai-editorial-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-editorial-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-editorial-empty-state-{{ ai_gen_id }}">
                Add an image to complete the editorial layout
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ai-editorial-text-column-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-editorial-title-{{ ai_gen_id }}">
            {{ block.settings.title }}
          </h2>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="ai-editorial-text-{{ ai_gen_id }}">
            {{ block.settings.text }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

