      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_direction",
      "label": "Layout direction",
      "options": [
        {
          "value": "image_left",
          "label": "Image left / Text right"
        },
        {
          "value": "text_left",
          "label": "Text left / Image right"
        }
      ],
      "default": "image_left"
    },
    {
      "type": "select",
      "id": "text_alignment",
