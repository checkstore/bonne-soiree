{% doc %}
  @prompt
    Create a customizable button section for the Bonne Soirée theme, minimal and editorial in style.
    
    Requirements:
    
    The button must be rectangular, with no border-radius (completely straight edges).
    
    The font must be "Times New Roman", serif.
    
    Allow editing of the button text, URL, and alignment (left, center, right).
    
    Add settings to customize:
    
    Text color
    
    Background color
    
    Border color
    
    Border thickness (in px)
    
    The button should have a hover effect where the background becomes transparent and the text and border use the main color.
    
    Include padding and spacing options (top & bottom margins).
    
    Design style:
    
    Minimal, elegant, and consistent with an editorial luxury brand.
    
    Default colors: black text on white background, 1px black border.
    
    Center the button by default.
    
    Schema settings:
    
    heading (optional)
    
    button_text
    
    button_link
    
    text_color
    
    background_color
    
    border_color
    
    border_thickness
    
    alignment
    
    padding_top / padding_bottom
    
    Make sure all styles are scoped to this section and do not affect other theme elements., Please correct the section so that the button text is displayed in “Times New Roman”, serif — not the theme’s default font., Update the custom button section to include a refined hover interaction.
    
    Hover behavior:
    
    When the cursor hovers over the button:
    
    The background color becomes transparent.
    
    The text color and border color invert (swap with the previous background color).
    
    The transition should be smooth (transition: all 0.3s ease;).
    
    Maintain straight corners (no border-radius).
    
    Font must remain Times New Roman, regular weight.
    
    Notes:
    
    Keep all schema settings and customization options (text color, background, border color, thickness, alignment, etc.) as they are.
    
    Scope styles only within this section (no global edits).
    
    Ensure the hover works on both desktop and mobile (tap feedback)., Update the button hover effect for better contrast.
    
    Corrections:
    
    When hovering, do not turn the text white.
    
    Instead, make the background transparent and keep the text and border colors equal to the original border color (ensuring visibility even on white backgrounds).
    
    Example: if the button has a black border and white background, on hover it should have transparent background, black text, and black border.
    
    Keep transition: all 0.3s ease; for smooth animation.
    
    Maintain rectangular shape (no border-radius) and Times New Roman font.
    
    Leave all schema settings, colors, and alignment options unchanged.
    
    Scope all CSS to this section only., Update the custom button section to include a clear hover state.
    
    Hover effect:
    
    When the mouse hovers over the button:
    
    Background changes to black (#000000).
    
    Text color changes to off-white (#F5F1EB).
    
    Border color also becomes black.
    
    Smooth transition (transition: all 0.3s ease;).
    
    Keep normal state colors and all customization settings (text color, background color, border color/thickness) intact.
    
    Font: Times New Roman, regular, weight 400.
    
    Shape: rectangular, border-radius: 0.
    
    Scope hover styles only to this section.
    
    Do not alter layout, schema, or functionality — only update the hover appearance as described.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-button-container-{{ ai_gen_id }} {
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    text-align: {{ block.settings.alignment }};
  }

  .ai-editorial-button-heading-{{ ai_gen_id }} {
    margin: 0 0 20px 0;
    font-family: "Times New Roman", serif !important;
    font-size: 24px;
    color: #000000;
    text-align: {{ block.settings.alignment }};
  }

  .ai-editorial-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 16px 32px;
    font-family: "Times New Roman", serif !important;
    font-size: 16px;
    font-weight: 400;
    text-decoration: none;
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    border-radius: 0 !important;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    transition: all 0.3s ease;
    cursor: pointer;
    letter-spacing: 0.5px;
    text-transform: none;
    line-height: 1.2;
  }

  .ai-editorial-button-{{ ai_gen_id }}:hover {
    background-color: #000000 !important;
    color: #F5F1EB !important;
    border-color: #000000 !important;
  }

  .ai-editorial-button-{{ ai_gen_id }}:active {
    background-color: #000000 !important;
    color: #F5F1EB !important;
    border-color: #000000 !important;
  }

  .ai-editorial-button-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.border_color }};
    outline-offset: 2px;
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-button-{{ ai_gen_id }} {
      padding: 14px 28px;
      font-size: 15px;
    }
  }
{% endstyle %}

<div
  class="ai-editorial-button-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <h2 class="ai-editorial-button-heading-{{ ai_gen_id }}">
      {{ block.settings.heading }}
    </h2>
  {% endif %}

  {% if block.settings.button_text != blank %}
    <a
      href="{{ block.settings.button_link | default: '#' }}"
      class="ai-editorial-button-{{ ai_gen_id }}"
      {% if block.settings.button_link == blank %}
        role="button"
        aria-disabled="true"
      {% endif %}
    >
      {{ block.settings.button_text }}
    </a>
  {% endif %}
</div>

{% schema %}
{
  "name": "Editorial button",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Button alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top spacing",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 40
    },
    {
      "type": "header",
      "content": "Button style"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "Border thickness",
      "default": 1
    }
  ],
  "presets": [
    {
      "name": "Editorial button"
    }
  ]
}
{% endschema %}