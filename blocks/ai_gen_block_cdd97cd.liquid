{% doc %}
  @prompt
    Create a new section called “Featured Collection (3×2 Grid)” in the Bonne Soirée style — minimal, editorial, and clean.
    
    Functionality:
    
    Display 6 products from a selected collection.
    
    Products should automatically update if the collection changes.
    
    Layout:
    
    Desktop: 3 columns × 2 rows (total of 6 products).
    
    Mobile: 2 columns × 3 rows (total of 6 products).
    
    Maintain equal spacing between items — around 24px on desktop and 16px on mobile.
    
    Center the section on the page with soft side padding (40px desktop, 20px mobile).
    
    Product Card:
    
    Show product image, title, and price.
    
    Image ratio fixed to 4:5, using object-fit: cover.
    
    No rounded corners — images must have perfectly straight edges:
    
    border-radius: 0 !important;
    
    
    No shadows or borders; the layout should remain clean and minimal.
    
    Title and price left-aligned, using Times New Roman, 16px and 14px respectively.
    
    Style:
    
    Overall look: editorial, airy, and balanced, matching Bonne Soirée’s neutral palette (#121212 text on white/off-white background).
    
    Add subtle hover effect on image: soft opacity fade or scale (no shadow).
    
    Schema settings:
    
    collection → Select collection to feature
    
    max_products → default 6
    
    columns_desktop → default 3
    
    columns_mobile → default 2
    
    spacing_desktop → default 24px
    
    spacing_mobile → default 16px, Image 4:5 (aspect-ratio:4/5; object-fit:cover; border-radius:0), no shadows.
    
    Title and price left-aligned, Times New Roman (400):
    
    .fc-card .title, .fc-card .price { 
      font-family:'Times New Roman', Times, serif !important; 
      font-weight:400 !important; 
      color:#121212; 
    }
    
    
    Prevent cards from stretching vertically; no fixed viewport heights.
    
    4) Schema (add if missing)
    
    max_products (default 6)
    
    max_width (default 1200)
    
    padding_top / padding_bottom
    
    gap_desktop (24) / gap_mobile (16)
    
    Goal
    
    Show up to 6 products (3×2 desktop, 2×3 mobile), with a balanced layout that does not fill the whole screen with 3 items.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-collection-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.padding_top }}px 40px {{ block.settings.padding_bottom }}px;
  }

  .ai-featured-collection-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.gap_desktop }}px;
    width: 100%;
  }

  .ai-featured-collection-item-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
    height: fit-content;
  }

  .ai-featured-collection-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 4/5;
    overflow: hidden;
    margin-bottom: 12px;
  }

  .ai-featured-collection-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .ai-featured-collection-item-{{ ai_gen_id }}:hover .ai-featured-collection-image-{{ ai_gen_id }} {
    opacity: 0.8;
    transform: scale(1.02);
  }

  .ai-featured-collection-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f8f8f8;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0;
  }

  .ai-featured-collection-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-featured-collection-content-{{ ai_gen_id }} {
    text-align: left;
  }

  .ai-featured-collection-title-{{ ai_gen_id }} {
    font-family: 'Times New Roman', Times, serif !important;
    font-weight: 400 !important;
    font-size: 16px;
    color: #121212;
    margin: 0 0 4px 0;
    line-height: 1.3;
  }

  .ai-featured-collection-price-{{ ai_gen_id }} {
    font-family: 'Times New Roman', Times, serif !important;
    font-weight: 400 !important;
    font-size: 14px;
    color: #121212;
    margin: 0;
    line-height: 1.2;
  }

  .ai-featured-collection-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
    font-size: 16px;
    font-style: italic;
  }

  @media screen and (max-width: 749px) {
    .ai-featured-collection-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    }

    .ai-featured-collection-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.gap_mobile }}px;
    }

    .ai-featured-collection-title-{{ ai_gen_id }} {
      font-size: 14px;
    }

    .ai-featured-collection-price-{{ ai_gen_id }} {
      font-size: 12px;
    }
  }
{% endstyle %}

<div class="ai-featured-collection-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.collection != blank %}
    {% assign collection_products = block.settings.collection.products | limit: block.settings.max_products %}
    
    {% if collection_products.size > 0 %}
      <div class="ai-featured-collection-grid-{{ ai_gen_id }}">
        {% for product in collection_products %}
          <a href="{{ product.url }}" class="ai-featured-collection-item-{{ ai_gen_id }}">
            <div class="ai-featured-collection-image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-featured-collection-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                >
              {% else %}
                <div class="ai-featured-collection-placeholder-{{ ai_gen_id }}">
                  {{ 'product-apparel-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            
            <div class="ai-featured-collection-content-{{ ai_gen_id }}">
              <h3 class="ai-featured-collection-title-{{ ai_gen_id }}">{{ product.title }}</h3>
              <div class="ai-featured-collection-price-{{ ai_gen_id }}">
                {% if product.compare_at_price > product.price %}
                  <span style="text-decoration: line-through; opacity: 0.6;">{{ product.compare_at_price | money }}</span>
                  <span style="margin-left: 8px;">{{ product.price | money }}</span>
                {% else %}
                  {{ product.price | money }}
                {% endif %}
              </div>
            </div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-featured-collection-empty-state-{{ ai_gen_id }}">
        A coleção selecionada não possui produtos disponíveis.
      </div>
    {% endif %}
  {% else %}
    <div class="ai-featured-collection-empty-state-{{ ai_gen_id }}">
      Selecione uma coleção para exibir os produtos.
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Featured collection grid",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 6,
      "label": "Maximum products"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1200,
      "label": "Maximum width"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40,
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40,
      "label": "Bottom padding"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "min": 8,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 24,
      "label": "Desktop gap"
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16,
      "label": "Mobile gap"
    }
  ],
  "presets": [
    {
      "name": "Featured collection grid"
    }
  ]
}
{% endschema %}