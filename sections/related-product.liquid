{{ 'custom.related-product.css' | asset_url | stylesheet_tag }}
{% render 'variables.related-product' %}
{% if template.name == 'cart' and cart.items != blank %}
  <div class="related-products">
    <h2 class="compre-junto">{{ section.settings.title }}</h2>
    <div
      id="related-products-container"
      {% if template.name == 'cart' %}
      data-product-id="{{ cart.items.first.product_id }}"
      {% elsif template.name == 'product' %}
      data-product-id="{{ product.id }}"
      {% endif %}>
      <div class="related-products__content"></div>
    </div>
  </div>
{% elsif template.name == 'product' %}
  <div class="related-products">
    <h2 class="compre-junto">{{ section.settings.title }}</h2>
    <div
      id="related-products-container"
      {% if template.name == 'cart' %}
      data-product-id="{{ cart.items.first.product_id }}"
      {% elsif template.name == 'product' %}
      data-product-id="{{ product.id }}"
      {% endif %}>
      <div class="related-products__content"></div>
    </div>
  </div>
{% endif %}

<script src="{{ "custom.related-product.js"  | asset_url }}" defer></script>

