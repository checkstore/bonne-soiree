{{ 'custom.banner-carrousel.css' |  asset_url |  stylesheet_tag }}
{% render 'variables.banner-carousel' %}
<div class="slideshow-banner {% if section.settings.first_banner_page == true %} slideshow-banner__first-banner--{{ section.id }}{% endif %} ">
    <div class="swiper swiper-slideshow swiper-slideshow--{{ section.id }}">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          {% if block.type == 'image' %}
            <div class="swiper-slide slide-banner slide-banner--{{ block.id }}">
              {% if block.settings.link != blank %}<a class="link-banner"href="{{ block.settings.link }}">{% endif %}
                    <div class="slideshow-banner__image">
                        {% if block.settings.image and block.settings.image_mobile  %}
                            <img class="desktop" src="{{ block.settings.image | img_url: 'master' }}" alt="">
                            <img class="mobile" src="{{ block.settings.image_mobile | img_url: 'master' }}" alt="">
                        {% endif %}
                    </div>
                    
                    <div class="slideshow-banner__content slideshow-banner__content--{{ block.id }}">
                      {% if block.settings.subtitle %}
                          <div class="text-subtitle">{{ block.settings.subtitle }}</div>
                      {% endif %}
                      {% if block.settings.title %}
                          <div class="text-title">{{ block.settings.title }}</div>
                      {% endif %}
                      {% if block.settings.text %}          
                        <div class="text-body">{{ block.settings.text }}</div> 
                      {% endif %}
                      {% if block.settings.button_text != blank %}
                          <a class="link_btn" href="{{ block.settings.link_btn }}"><div class="text_button">{{ block.settings.button_text }}</div></a>
                      {% endif %}
                    </div>
              {% if block.settings.link != blank %}</a>{% endif %}              
            </div>
          {% elsif block.type == 'video' %}
            <div class="swiper-slide slide-banner slide-banner--{{ block.id }}">
              {% if block.settings.link != blank %}<a class="link-banner"href="{{ block.settings.link }}">{% endif %}
                    <div class="slideshow-banner__video">
                        <video class="desktop-video-slide {% if block.settings.container_image == true %} container {% endif %}" playsinline="true" width="auto" height="auto" preload="metadata" autoplay="true" muted loop>
                            <source  playsinline="true" src="{{ block.settings.video_desktop.sources[1].url }}" type="video/mp4">
                        </video>
                        <video class="mobile-video-slide {% if block.settings.container_image == true %} container {% endif %}" playsinline="true"width="auto" height="auto" preload="metadata" autoplay="true" muted loop>
                            <source controlslist="nofullscreen" src="{{ block.settings.video_mobile.sources[1].url }}" type="video/mp4">
                        </video>
                    </div>
                    
                    <div class="slideshow-banner__content slideshow-banner__content--{{ block.id }}">
                      {% if block.settings.subtitle %}
                          <div class="text-subtitle">{{ block.settings.subtitle }}</div>
                      {% endif %}
                      {% if block.settings.title %}
                          <div class="text-title">{{ block.settings.title }}</div>
                      {% endif %}
                      {% if block.settings.text %}          
                        <div class="text-body">{{ block.settings.text }}</div> 
                      {% endif %}
                      {% if block.settings.button_text != blank %}
                          <a class="link_btn" href="{{ block.settings.link_btn }}"><div class="text_button">{{ block.settings.button_text }}</div></a>
                      {% endif %}
                    </div>
              {% if block.settings.link != blank %}</a>{% endif %}              
            </div>
          {% endif %}     
        {% endfor %}
      </div>

    <div class="swiper-pagination swiper-pagination--{{ section.id }} swiper-pagination-banner-carroussel"></div>
    {% assign blocksCount = section.blocks | size %}
    {% if blocksCount > 1 %}
      <div class="swiper-button-prev swiper-button-prev--{{ section.id }}"></div>
      <div class="swiper-button-next swiper-button-next--{{ section.id }}"></div> 
    {% endif %}
</div>

<script>
document.addEventListener('DOMContentLoaded', function(){    
    const swiperSlideshow = new Swiper('.swiper-slideshow--{{ section.id }}', {
    // Optional parameters
    direction: 'horizontal',
    loop: true,
    spaceBetween: 30,
    slidesPerView: 1,

    // If we need pagination
    pagination: {
        el: '.swiper-pagination--{{ section.id }}',
    },

    // Navigation arrows
    navigation: {
        nextEl: '.swiper-button-next--{{ section.id }}',
        prevEl: '.swiper-button-prev--{{ section.id }}',
    },
  });
});
</script>
