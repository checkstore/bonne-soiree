{{ 'custom.grid-images.css' |  asset_url |  stylesheet_tag }}
{% render 'variables.grid-images' %}

<div class="container_title">
    <p class="title_section">{{ section.settings.title_section }}</p>
</div> 

<div class="grid-image">
    {% for block in section.blocks %}
    <div class="container__grid-image container__grid-image--{{block.id}}">
        <a href="{{ block.settings.link }}" class="link__grid-images">
            <img src="{{ block.settings.image | img_url: 'master' }}" alt="" class="image__grid-image image__grid-image--{{block.id}}">
            <div class="content__grid-image content__grid-image--{{block.id}}">
                <div class="content__grid-image_text">
                    <h3 class="title__grid-image">{{ block.settings.title }}</h3>
                    <p class="description__grid-image">{{ block.settings.description }}</p>
                </div>
            </div>
        </a>
    </div>
    {% endfor %}
</div>

{% schema %}
{
    "name": "Grid Image",
    "max_blocks": 3,
    "settings": [
        {
        "type": "header",
