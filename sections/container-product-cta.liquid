{{ "custom.container-product-cta.css" |  asset_url |  stylesheet_tag  }}
{% render 'variables.container-product-cta' %}

<div class="container_product_cta">
    <div class="container_info_product">
        <h2 class="title_info_product">{{ section.settings.title }}</h2>
        <p class="description_info_product">{{ section.settings.description }}</p>
        <a href="{{ section.settings.btn_url }}" class="btn_info_product">{{ section.settings.btn_text }}</a>
    </div>
    <div class="container_product">
        <div class="container_product_top">
            {% for block in section.blocks %}
                {% case block.type %}
                    {% when 'product_top' %}
                        <div class="content_image_product">
                            <img src="{{ block.settings.product_item.featured_image | img_url: 'master' }}" alt="Image product" class="image_product">
                            <a href="{{ block.settings.product_item.url }}" class="btn_product_before">{% render 'icon' with 'bag_cta' %} <p>{{ section.settings.text_hover_bag }}</p></a>
                        </div>
                {% endcase %}
            {% endfor %}
        </div>  
        <div class="container_product_bottom">
            {% for block in section.blocks %}
                {% case block.type %}
                    {% when 'product_bottom' %}
                        <div class="content_image_product">
                            <img src="{{ block.settings.product_item.featured_image | img_url: 'master' }}" alt="Image product" class="image_product">
                            <a href="{{ block.settings.product_item.url }}" class="btn_product_before">{% render 'icon' with 'bag_cta' %} <p>{{ section.settings.text_hover_bag }}</p></a>
                        </div>
                {% endcase %}
            {% endfor %}
        </div>  
    </div>
    <div class="container_product_mobile">
        {% for block in section.blocks %}
            {% case block.type %}
                {% when 'product_mobile' %}
                    <a href="{{ block.settings.product_item.url }}" class="link_mobile">
                    <div class="content_image_product">
                        <img src="{{ block.settings.product_item.featured_image | img_url: 'master' }}" alt="Image product" class="image_product">
                    </div>
                    </a>
            {% endcase %}
        {% endfor %}
    </div>
</div>

{% schema %}
{
    "name": "Container Product CTA",
    "settings": [
        {
            "type": "header",
            "content": "Section content"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Title"
        },
        {
            "type": "textarea",
            "id": "description",
            "label": "Description",
            "default": "Description"
        },
        {
            "type": "url",
            "id": "btn_url",
            "label": "Link button"
        },
        {
            "type": "text",
            "id": "btn_text",
            "label": "Text button",
            "default": "see collection"
        },
        {
            "type": "header",
            "content": "Text hover bag"
        },
        {
            "type": "text",
            "id": "text_hover_bag",
            "label": "Text hover bag",
            "default": "see the product"
        },
        {
            "type": "header",
            "content": "Configuration section"
        },
        {
        "type": "header",
        "content": "Height section"
        },
        {
        "type": "select",
        "id": "height_section",
        "label": "Height section",
        "default": "700px",
        "options": [
            { "value": "960px", "label": "960px" },
            { "value": "700px", "label": "700px" }
        ]
        },
        {
            "type": "header",
            "content": "Configuration CTA"
        },
        {
            "type": "color",
            "id": "color_title",
            "label": "Color Title",
            "default": "#F3F3F1"
        },
        {
            "type": "color",
            "id": "color_description",
            "label": "Color Description",
            "default": "#FFFFFF"
        },
        {
            "type": "color",
            "id": "color_btn",
            "label": "Color Button",
            "default": "#FFFFFF"
        },
        {
            "type": "color",
            "id": "color_background_btn",
            "label": "Background color button",
            "default": "#000000" 
        },
        {
            "type": "color",
            "id": "color_btn_hover",
            "label": "Color Button hover",
            "default": "#000000"
        },
        {
            "type": "color",
            "id": "color_background_btn_hover",
            "label": "Background color button hover",
            "default": "#FFFFFF" 
        },
        {
            "type": "range",
            "id": "border_radius_btn",
            "label": "Border radius button",
            "min": 0,
            "max": 100,
            "step": 1,
            "default": 30
        }
    ],
    "blocks": [
        {
            "type": "product_top",
            "name": "Product top",
            "limit": 2,
            "settings": [
                {
                    "type": "product",
                    "id": "product_item",
                    "label": "Product"
                }
            ]
        },
        {
            "type": "product_bottom",
            "name": "Product bottom",
            "limit": 2,
            "settings": [
                {
                    "type": "product",
                    "id": "product_item",
                    "label": "Product"
                }
            ]
        },
        {
            "type": "product_mobile",
            "name": "Product mobile",
            "limit": 3,
            "settings": [
                {
                    "type": "product",
                    "id": "product_item",
                    "label": "Product"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Container Product CTA"
        }
    ]
}
{% endschema %}