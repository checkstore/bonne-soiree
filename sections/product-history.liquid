{{ 'custom.product-history.css' | asset_url | stylesheet_tag }}
{{ 'custom.product-history.js' | asset_url | script_tag }}

<div class="listViewedProducts">
  {%- if section.settings.title != blank -%}
    <h2 class="title inline-richtext">
      {{ section.settings.title }}
    </h2>
  {%- endif -%}
  <div class="listViewedProducts"></div>
</div>

{% schema %}
{
  "name": "t:sections.product-history.name",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "Recently Viewed Products",
      "label": "t:sections.featured-collection.settings.title.label"
    }
  ],
  "presets": [
    {
      "category": "product",
      "name": "Recently Viewed Products"
    }
  ]
}
{% endschema %}