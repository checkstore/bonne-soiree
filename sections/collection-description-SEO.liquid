{{'custom.collection-description-SEO.css' |  asset_url |  stylesheet_tag}}
{% render 'variables.collection-description-SEO' %}

{% assign collection_description_text = collection.description %}
{% if collection_description_text != blank %}
  <section class="section-collection-description">
    <div class="page-widthSE0 section-container content-description minus">
      {{ collection_description_text }}
    </div>
    <a href="#" class="toggle-link">
      <svg fill="#000000" width="10px" height="10px" viewBox="0 0 32 32" version="1.1" xmlns="http://www.w3.org/2000/svg"><path d="M0.256 8.606c0-0.269 0.106-0.544 0.313-0.75 0.412-0.412 1.087-0.412 1.5 0l14.119 14.119 13.913-13.912c0.413-0.412 1.087-0.412 1.5 0s0.413 1.088 0 1.5l-14.663 14.669c-0.413 0.413-1.088 0.413-1.5 0l-14.869-14.869c-0.213-0.213-0.313-0.481-0.313-0.756z"></path></svg>  
    </a>
  </section>
{% endif %}

<script>

document.addEventListener("DOMContentLoaded", function() {
    const toggleLink = document.querySelector(".toggle-link");
    const contentDescription = document.querySelector(".content-description");
    const downArrowSVG = `<svg fill="#000000" width="10px" height="10px" viewBox="0 0 32 32" version="1.1" xmlns="http://www.w3.org/2000/svg"><path d="M0.256 8.606c0-0.269 0.106-0.544 0.313-0.75 0.412-0.412 1.087-0.412 1.5 0l14.119 14.119 13.913-13.912c0.413-0.412 1.087-0.412 1.5 0s0.413 1.088 0 1.5l-14.663 14.669c-0.413 0.413-1.088 0.413-1.5 0l-14.869-14.869c-0.213-0.213-0.313-0.481-0.313-0.756z"></path></svg>`;
    const upArrowSVG = `<svg fill="#000000" width="10px" height="10px" viewBox="0 0 32 32" version="1.1" xmlns="http://www.w3.org/2000/svg"> <path d="M0.256 23.481c0 0.269 0.106 0.544 0.313 0.75 0.412 0.413 1.087 0.413 1.5 0l14.119-14.119 13.913 13.912c0.413 0.413 1.087 0.413 1.5 0s0.413-1.087 0-1.5l-14.663-14.669c-0.413-0.412-1.088-0.412-1.5 0l-14.869 14.869c-0.213 0.212-0.313 0.481-0.313 0.756z"></path></svg>`;

    toggleLink.addEventListener("click", function(event) {
      event.preventDefault();

      if (contentDescription.classList.contains("minus")) {
        contentDescription.classList.remove("minus");
        toggleLink.innerHTML = upArrowSVG;
      } else {
        contentDescription.classList.add("minus");
        toggleLink.innerHTML = downArrowSVG;
      }
    });
  });
                  
</script>

<script>
  const readNotes = () => {
    document.addEventListener('DOMContentLoaded', () => {
      const buttonMoreDescription = document.querySelector('#descriptionReadMore');
      const buttonGroup = document.querySelector('.group-button');
      const moreDescriptionSection = document.querySelector('.collection-description__actions');
      const completeDescription = document.querySelector('.complete_description');
      let previewDescription = document.querySelector('.preview_description');
      let moreDescriptionOpened = false;
      buttonMoreDescription.addEventListener('click', (event) => {
        moreDescriptionOpened = !moreDescriptionOpened;
        completeDescription.classList.toggle('closed_description');

        if({{ section.settings.opcao_checkbox }}){
          if (!buttonGroup.querySelector('.text-button-SEO')) buttonGroup.innerHTML = '<p class="text-button-SEO"></p>';
          buttonGroup.querySelector('.text-button-SEO').textContent = moreDescriptionOpened ? '{{ section.settings.text_button_SEO_complete }}' : '{{ section.settings.text_button_SEO_preview }}';
        }

        const iconButtonSEOImage = buttonMoreDescription.querySelector('.icon-button-SEO');
        if (iconButtonSEOImage) {
          iconButtonSEOImage.classList.toggle('imagem-invertida', moreDescriptionOpened);
        }
    })
    })
  } 
  readNotes()
</script>

