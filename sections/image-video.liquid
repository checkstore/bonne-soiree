{{ 'custom.image-video.css' |  asset_url |  stylesheet_tag }}
{% render 'variables.image-video' %}

{% for block in section.blocks %}
    {% if block.type == 'image' %}
        <div class="banner-image banner-image--{{ block.id }} {% if block.settings.container_image == true %} container {% endif %}">
            {% if block.settings.image_desktop or block.settings.image_mobile %}
                <img class="desktop-banner-image {% if block.settings.container_image == true %} container {% endif %}" src="{{ block.settings.image_desktop |  img_url: 'master' }}" alt="{{ block.settings.title }}">
                <img class="mobile-banner-image {% if block.settings.container_image == true %} container {% endif %}" src="{{ block.settings.image_mobile | img_url: 'master'  }}" alt="{{ block.settings.title }}">
            {% endif %}
            
            <div class="banner-text banner-text--{{ block.id }}">
                <div class="title-img">{{ block.settings.title }}</div>
                <div class="text-img">{{ block.settings.text }}</div>
                <a class="link-text-btn" href="{{ block.settings.url_button }}"><div class="text-btn {% if block.settings.underline_button_desktop == true %} underline {% endif %} ">{{ block.settings.text_button }}</div></a>
            </div>
      </div>
    {% elsif block.type == 'video' %}
      <div class="banner-video banner-video--{{ block.id }} {% if block.settings.container_image == true %} container {% endif %}">
        <video class="desktop-video-image {% if block.settings.container_image == true %} container {% endif %}" width="auto" height="auto" preload="metadata" autoplay="true" muted loop>
          <source playsinline="true" src="{{ block.settings.video_desktop.sources[1].url }}" type="video/mp4">
        </video>
        <video class="mobile-video-image {% if block.settings.container_image == true %} container {% endif %}" width="auto" height="auto" preload="metadata" autoplay="true" muted loop>
            <source controlslist="nofullscreen" src="{{ block.settings.video_mobile.sources[1].url }}" type="video/mp4">
        </video>
        <div class="banner-text banner-text--{{ block.id }}">
          <div class="title-img">{{ block.settings.title }}</div>
          <div class="text-img">{{ block.settings.text }}</div>
          <a class="link-text-btn" href="{{ block.settings.url_button }}"><div class="text-btn {% if block.settings.underline_button_desktop == true %} underline {% endif %}">{{ block.settings.text_button }}</div></a>
        </div>
      </div>
    {% endif %}
{% endfor %}

