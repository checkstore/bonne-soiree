        "custom_liquid_hqgYxp": {
          "type": "custom_liquid",
          "name": "Encomende",
          "settings": {
            "custom_liquid": "{%- assign current_variant = product.selected_or_first_available_variant -%}\n{%- assign wa_phone = '5511910910055' -%}\n{% if product.title contains \"Couro\" %}\n<div\n  class=\"wa-order\"\n  data-wa-order\n  data-product-id=\"{{ product.id }}\"\n  data-product-title=\"{{ product.title | escape }}\"\n  data-product-url=\"{{ shop.url }}{{ product.url }}\"\n  data-wa-phone=\"{{ wa_phone }}\"\n  {% unless current_variant.available %}data-show data-variant-id=\"{{ current_variant.id }}\"{% endunless %}\n>\n  <a href=\"#\" class=\"wa-order__btn\" target=\"_blank\" rel=\"noopener\" data-wa-trigger>\n    Encomende pelo WhatsApp\n  </a>\n</div>\n{% endif %}\n<script type=\"application/json\" data-wa-variants-{{ product.id }}>\n  {{ product.variants | json }}\n</script>\n\n{%- style -%}\n  .wa-order { display: none; margin-top: 12px; }\n  .wa-order[data-show] { display: block; }\n  .wa-order__btn {\n    display: block; width: 100%;\n    padding: 14px 20px;\n    background: #111; color: #fff;\n    border: 1px solid #111; border-radius: 4px;\n    font: 600 14px/1 inherit;\n    text-align: center; text-decoration: none;\n    cursor: pointer;\n  }\n  .wa-order__btn:hover { background: #2a2a2a; color: #fff; }\n{%- endstyle -%}\n\n<script>\n(function () {\n  var productId = {{ product.id }};\n  var wrapper = document.querySelector('[data-wa-order][data-product-id=\"' + productId + '\"]');\n  if (!wrapper) return;\n\n  var variants = JSON.parse(document.querySelector('[data-wa-variants-' + productId + ']').textContent);\n  var byId = {};\n  variants.forEach(function (v) { byId[v.id] = v; });\n\n  var phone = wrapper.getAttribute('data-wa-phone');\n  var productTitle = wrapper.getAttribute('data-product-title');\n  var productUrl = wrapper.getAttribute('data-product-url');\n  var trigger = wrapper.querySelector('[data-wa-trigger]');\n\n  var form = wrapper.closest('product-form, .product-form, form[action*=\"/cart/add\"]')\n          || document.querySelector('form[action*=\"/cart/add\"]');\n\n  function getSelectedId() {\n    if (form) {\n      var idInput = form.querySelector('[name=\"id\"]');\n      if (idInput && idInput.value) return parseInt(idInput.value, 10);\n    }\n    var v = new URL(window.location.href).searchParams.get('variant');\n    return v ? parseInt(v, 10) : null;\n  }\n\n  function buildHref(variant) {\n    var label = variants.length > 1 ? productTitle + ' (' + variant.title + ')' : productTitle;\n    var msg = 'Olá! Quero encomendar: ' + label + '. Link: ' + productUrl;\n    return 'https://api.whatsapp.com/send?phone=' + phone + '&text=' + encodeURIComponent(msg);\n  }\n\n  function render() {\n    var id = getSelectedId();\n    var variant = id ? byId[id] : null;\n    if (variant && variant.available === false) {\n      wrapper.setAttribute('data-show', '');\n      wrapper.setAttribute('data-variant-id', id);\n      trigger.setAttribute('href', buildHref(variant));\n    } else {\n      wrapper.removeAttribute('data-show');\n      trigger.setAttribute('href', '#');\n    }\n  }\n\n  if (form) form.addEventListener('change', render);\n  document.addEventListener('variant:change', render);\n  document.addEventListener('shopify:variant:change', render);\n  window.addEventListener('popstate', render);\n\n  if (form) {\n    var idInput = form.querySelector('[name=\"id\"]');\n    if (idInput) {\n      var lastValue = idInput.value;\n      setInterval(function () {\n        if (idInput.value !== lastValue) { lastValue = idInput.value; render(); }\n      }, 400);\n    }\n  }\n\n  render();\n})();\n</script>"
          }
        },
