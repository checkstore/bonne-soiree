<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@id": "{{ shop.url }}{{ product.url }}#MainContent",
    "@type": "Product",
    "name": "{{ product.title }}",
    "image": "{{ product.featured_image.src | image_url: width: 500 | prepend: "https:" }}",
    {% if product.metafields.custom.seo_short_description %}
    "description": {{ product.metafields.custom.seo_short_description | json }},
    {% else %}
    "description": {{ product.description | strip_html | json }},
    {% endif %}
    "releaseDate": "{{ product.created_at | date: "%Y-%m-%d" }}",
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | json }}
    },
    {% for option in product.options_with_values %}{% if option.name contains 'cor' or option.name contains 'Cor' %}
    "color": "{{ option.values.first }}",
    {% break %}{% endif %}{% endfor %}
    "category": {{ product.type | json }},
    "model": {{ product.title | json }},
    {% if product.metafields.custom.material != blank %}
    "material": "{{ product.metafields.custom.seo_material }}",
    {% endif %}
    "sku": "{{ product.first_available_variant.sku }}",
    "productId": "{{ product.id }}",
    {% if product.metafields.custom.seo_is_accessory_or_spare_part_for != blank %}
    "isAccessoryOrSparePartFor": {
      "@type": "Product",
      "name": "{{ product.metafields.custom.seo_is_accessory_or_spare_part_for.value.title }}"
    },
    {% endif %}
    "isRelatedTo": {
      "@type": "Product",
      "name": "{{ product.collections.first.products.last.title }}"
    },
    "isSimilarTo": {
      "@type": "Product",
      "name": "{{ product.collections.first.products.first.title }}"
    },
    {% comment %}
      {%- assign judgeme = product.metafields.judgeme.badge | json -%}
      {%- if judgeme -%}
        {%- assign review_count = judgeme | split: "data-number-of-reviews='" | last | split: "'" |first | plus: 0 -%}
        {%- assign review_value = judgeme | split: "data-average-rating='" | last | split: "'" |first | plus: 0 -%}
        {%- if review_count > 0 -%}
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": {{ review_value | json }},
            "reviewCount": {{ review_count | json }}
          },
        {%- else -%}
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": 1,
            "reviewCount": 1
          },
        {%- endif -%}
      {%- endif -%}
    {% endcomment %}
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type" : "Offer",
          {% if settings.seo_return_policy_days and settings.seo_return_policy_country %}
            "hasMerchantReturnPolicy": {
              "@type": "MerchantReturnPolicy",
              "applicableCountry": "{{ settings.seo_return_policy_country }}",
              "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
              "merchantReturnDays": {{ settings.seo_return_policy_days }},
              "returnMethod": "https://schema.org/ReturnByMail",
              "returnFees": "https://schema.org/FreeReturn"
            },
          {% endif %}
          "shippingDetails": {
            "@type": "OfferShippingDetails",
            "shippingDestination": {
              "@type": "DefinedRegion",
              "addressCountry": "{{ shop.address.country_code }}"
            },
            "shippingOrigin": {
              "@type": "DefinedRegion",
              "addressCountry": "{{ shop.address.country_code }}"
            },
            "deliveryTime": {
              "@type": "ShippingDeliveryTime",
              "handlingTime": {
                "@type": "QuantitativeValue",
                "value": 2,
                "unitCode": "d",
                "minValue": 0,
                "maxValue": 2
              },
              "transitTime": {
                "@type": "QuantitativeValue",
                "unitCode": "d",
                "minValue": 1,
                "maxValue": 60
              }
            },
            "shippingRate": {
              "@type": "MonetaryAmount",
              "currency": "{{ cart.currency.iso_code }}",
              "minValue": 0,
              "maxValue": 99
            }
          },
          {%- if variant.sku != blank -%}
            "sku": {{ variant.sku | json }},
          {%- endif -%}
          {%- if variant.barcode.size == 12 -%}
              "gtin12": {{ variant.barcode }},
          {%- endif -%}
          {%- if variant.barcode.size == 13 -%}
            "gtin13": {{ variant.barcode }},
          {%- endif -%}
          {%- if variant.barcode.size == 14 -%}
            "gtin14": {{ variant.barcode }},
          {%- endif -%}
          "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price" : {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency" : {{ cart.currency.iso_code | json }},
          {% if product.metafields.custom.seo_price_valid_until != blank %}
          "priceValidUntil": "{{ product.metafields.custom.seo_price_valid_until | date }}",
          {% else %}
          "priceValidUntil": "{{ 'today' |  date: '%Y-%m-%d' }}",
          {% endif %}
          "url" : {{ request.origin | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
    {% if settings.seo_return_policy_days and settings.seo_return_policy_country %}
      "hasMerchantReturnPolicy": {
        "@type": "MerchantReturnPolicy",
        "applicableCountry": "{{ settings.seo_return_policy_country }}",
        "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
        "merchantReturnDays": {{ settings.seo_return_policy_days }},
        "returnMethod": "https://schema.org/ReturnByMail",
        "returnFees": "https://schema.org/FreeReturn"
      },
    {% endif %}
    "logo": "{{ settings.logo | image_url: width: 500 | prepend: "https:" }}",
    "audience": {
      "@context": "https://schema.org",
      "@type": "PeopleAudience",
      "@id": "PeopleAudience",
      "suggestedMinAge": 5.0,
      "audienceType": "Public"
    }
  }
</script>