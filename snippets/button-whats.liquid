<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

<div class="container_button_whats">
    <a class="button_whats_link" href="https://api.whatsapp.com/send?phone={{ settings.whatsapp_number}}" target="_blank">
        <p class="text_button_whats">{{ settings.whatsapp_label }}</p>

        <i class="fa fa-whatsapp" style="font-size:25px;color:white"></i>
    </a>
</div>

<style>
.container_button_whats {
    position: fixed;
    bottom: 30px;
    right: 30px;
    z-index: 9999;
    background-color: #1b1c1d;
    height: 50px;
    width: auto;
    border-radius: 50px;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
    transition: background-color 0.3s ease;
    padding: 0 14px;
    transition: .6s cubic-bezier(0.075, 0.82, 0.165, 1);
}
.container_button_whats:hover {
    background-color: #128c7e;
}

.button_whats_link {
    text-decoration: none;
    color: #ffffff;
    display: flex;
    align-items: center;
    width: 100%;
    height: 100%;
}
.text_button_whats {
    margin: 0px;
    margin-right: 8px;
    font-size: 14px;
}

@media screen and (max-width: 768px) {
    .container_button_whats {
        bottom: 20px;
        right: 20px;
    }

    .text_button_whats {
        font-size: 12px;
    }

  .container_button_whats.cart-open {
    bottom: 87px;
    height: 40px;
    padding: 0 10px;
  }
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    function toggleCartOpen() {
        document.querySelector('.container_button_whats').classList.add('cart-open');
    }

    document.querySelectorAll('.product-form__buttons').forEach(formSubmit => {
        formSubmit.addEventListener('click', toggleCartOpen);
    });

    document.querySelector('.header__icon--cart').addEventListener('click', toggleCartOpen);
  });
</script>