<style>

  {% for block in section.blocks %}
    {% if block.type == 'image' %}
      {% if section.settings.height_fixed == true %}
      .slide-banner--{{ block.id }} .slideshow-banner__image {
        --height-imagem: {{ block.settings.height_image }}px;    
        height: var(--height-imagem);
      }
      @media screen and (max-width: 1024px) {
        .slide-banner--{{ block.id }} .slideshow-banner__image {
          --height-imagem: calc({{ block.settings.height_image }}px / 1.3);    
          height: var(--height-imagem);
        }       
      }
      @media screen and (max-width: 550px) {
        .slide-banner--{{ block.id }} .slideshow-banner__image {
          --height-imagem: calc({{ block.settings.height_image }}px / 1.2);    
          height: var(--height-imagem);
        }       
      }
      {% else %}
      .slide-banner--{{ block.id }} .slideshow-banner__image {     
        height: auto;
      }
      {% endif %}
    {% elsif block.type == 'video' %}
      {% if section.settings.height_fixed == true %}
      .slide-banner--{{ block.id }} .slideshow-banner__video{  
        --height-video: {{ block.settings.height_video }}px;     
        height: var(--height-video);
      }

      @media screen and (max-width: 1024px) {
        .slide-banner--{{ block.id }} .slideshow-banner__video{  
        --height-video:  calc({{ block.settings.height_video }}px / 1.3);     
        height: var(--height-video);
      }     
      }
      @media screen and (max-width: 550px) {
        .slide-banner--{{ block.id }} .slideshow-banner__video{  
        --height-video:  calc({{ block.settings.height_video }}px / 1.2);     
        height: var(--height-video);
       }       
      }
      {% else %}
      .slide-banner--{{ block.id }} .slideshow-banner__video {     
        height: auto;
      }
      {% endif %}
    {% endif %} 

    .slideshow-banner__first-banner--{{ section.id }} {
      margin-top: calc(-1* var(--header-height));
    }

    .slideshow-banner__content--{{ block.id }} {
      --position-horizontal-desktop: {{ block.settings.position_horizontal_desktop }};
      --position-vertical-desktop: {{ block.settings.position_vertical_desktop }};
      align-items: var(--position-horizontal-desktop);
      justify-content: var(--position-vertical-desktop);
    }

    .slideshow-banner__content--{{ block.id }}
    div.text-subtitle p {
      --color-text: {{ block.settings.color_text }};
      --font-size-subtitle-desktop: {{ block.settings.font_size_subtitle_desktop }}px;
      --position-text: {{ block.settings.position_horizontal_desktop }};
      text-align: var(--position-text);
      color: var(--color-text);
      font-size: var(--font-size-subtitle-desktop);
      font-family: var(--font-family-primary);
    }

    .slideshow-banner__content--{{ block.id }}
    div.text-title p {
      --color-text: {{ block.settings.color_text }};
      --font-size-title-desktop: {{ block.settings.font_size_title_desktop }}px;
      --position-text: {{ block.settings.position_horizontal_desktop }};
      text-align: var(--position-text);
      color: var(--color-text);
      font-size: var(--font-size-title-desktop);
      font-family: var(--font-family-secondary);
    }

    .slideshow-banner__content--{{ block.id }}
    div.text-body p {
      --color-text: {{ block.settings.color_text }};
      --font-size-body-desktop: {{ block.settings.font_size_body_desktop }}px;
      --position-text: {{ block.settings.position_horizontal_desktop }};
      text-align: var(--position-text);
      color: var(--color-text);
      font-size: var(--font-size-body-desktop);
      font-family: var(--font-family-primary);
    }

    .slideshow-banner__content--{{ block.id }}
    div.text_button p {
      --color-text: {{ block.settings.color_button }};
      --font-size-button-desktop: {{ block.settings.font_size_button_desktop }}px;
      --background-color: {{ block.settings.background_color }};
      --color-border: {{ block.settings.color_button_border }};
      --border-radius: {{ block.settings.border_radius }}px;
      --position-text: {{ block.settings.position_horizontal_desktop }};
      text-align: var(--position-text);
      color: var(--color-text);
      font-size: var(--font-size-button-desktop);
      background-color: var(--background-color);
      border: 2px solid var(--color-border);
      border-radius: var(--border-radius);
      font-family: var(--font-family-primary);
    }

    .slideshow-banner__content--{{ block.id }} div.text_button p:hover {
      --background-color: {{ block.settings.background_color_hover }};
      --color-text: {{ block.settings.color_button_hover }};
      --color-border: {{ block.settings.color_button_border_hover }};
      background: var(--background-color);
      color: var(--color-text);
      border: 2px solid var(--color-border);
    }

    .slide-banner--{{ block.id }} a.link_btn, 
    .slide-banner--{{ block.id }} a.link-banner {
      --position-horizontal-desktop: {{ block.settings.position_horizontal_desktop }};
      text-decoration: none;
      display: flex;
      flex-direction: column;
      align-items: var(--position-horizontal-desktop);
    }
  
    @media screen and (max-width: 1024px) {
      .slideshow-banner__content--{{ block.id }} {
        --position-horizontal-tablet: {{ block.settings.position_horizontal_tablet }};
        --position-vertical-tablet: {{ block.settings.position_vertical_tablet }};
        align-items: var(--position-horizontal-tablet);
        justify-content: var(--position-vertical-tablet);
      }

      .slideshow-banner__content--{{ block.id }}
      div.text-subtitle p {
        --font-size-subtitle-tablet: {{ block.settings.font_size_subtitle_tablet }}px;
        font-size: var(--font-size-subtitle-tablet);
      }

      .slideshow-banner__content--{{ block.id }}
      div.text-title p {
        --font-size-title-tablet: {{ block.settings.font_size_title_tablet }}px;
        font-size: var(--font-size-title-tablet);
      }

      .slideshow-banner__content--{{ block.id }}
      div.text-body p {
        --font-size-body-tablet: {{ block.settings.font_size_body_tablet }}px;
        font-size: var(--font-size-body-tablet);
        max-width: 360px;
      }

      .slideshow-banner__content--{{ block.id }}
      div.text_button p {
        --font-size-button-tablet: {{ block.settings.font_size_button_tablet }}px;
        font-size: var(--font-size-button-tablet);
        
      }
    }

    @media screen and (max-width: 768px) {

      .slideshow-banner__content--{{ block.id }}div.text-subtitle p {
        --font-size-subtitle-mobile: {{ block.settings.font_size_subtitle_mobile }}px;
        font-size: var(--font-size-subtitle-mobile);
      }

      .slideshow-banner__content--{{ block.id }}
      div.text-title p {
        --font-size-title-mobile: {{ block.settings.font_size_title_mobile }}px;
        font-size: var(--font-size-title-mobile);  
        }

      .slideshow-banner__content--{{ block.id }}
      div.text-body p {
        --font-size-body-mobile: {{ block.settings.font_size_body_mobile }}px;
        font-size: var(--font-size-body-mobile);
        max-width: 312px;
      }

      .slideshow-banner__content--{{ block.id }}
      div.text_button p {
        --font-size-button-mobile: {{ block.settings.font_size_button_mobile }}px;
        font-size: var(--font-size-button-mobile);
      }
    }

    @media screen and (max-width: 550px) {

    .slide-banner--{{ block.id }} a.link_btn, 
    .slide-banner--{{ block.id }} a.link-banner {
      --position-horizontal-mobile: {{ block.settings.position_horizontal_mobile }};
      text-decoration: none;
      display: flex;
      flex-direction: column;
      align-items: var(--position-horizontal-mobile);
    }
      .slideshow-banner__content--{{ block.id }} {
        --position-horizontal-mobile: {{ block.settings.position_horizontal_mobile }};
        --position-vertical-mobile: {{ block.settings.position_vertical_mobile}};
        align-items: var(--position-horizontal-mobile);
        justify-content: var(--position-vertical-mobile);
      }

      .slideshow-banner__content--{{ block.id }}div.text-subtitle p{
        --position-text-mobile: {{ block.settings.position_horizontal_mobile }};
        text-align: var(--position-text-mobile);
      }

      .slideshow-banner__content--{{ block.id }}
      div.text-title p {
        --position-text-mobile: {{ block.settings.position_horizontal_mobile }};
        text-align: var(--position-text-mobile);  
      }
      .slideshow-banner__content--{{ block.id }}
      div.text-body p{
        --position-text-mobile: {{ block.settings.position_horizontal_mobile }};
        text-align: var(--position-text-mobile);
      }

      .slideshow-banner__content--{{ block.id }}
      div.text_button p{
        --position-text-mobile: {{ block.settings.position_horizontal_mobile }};
          text-align: var(--position-text-mobile);
        }
    }
{% endfor %}


</style>