{% comment %} 
  Accepts:
    - product_list: the collection to render

  Usage: 
    {% render 'seo.schema.item-list',
      product_list: collection.products
    %}

{% endcomment %}

<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"ItemList",
  "itemListElement":[
    {% for product in product_list limit: 10 %}{
      "@type":"ListItem",
      "position":{{ forloop.index }},
      "url":"{{ shop.url }}{{ product.url }}",
      "name":{{ product.title | json }},
      {% if product.metafields.custom.description != blank %}"description": {{ product.metafields.custom.description.value | json }},{% endif %}
      "image":"{{ product.featured_image.src | image_url: width: 500 | prepend: "https:" }}"
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
</script>